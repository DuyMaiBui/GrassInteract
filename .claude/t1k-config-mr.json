{
  "registryVersion": 1,
  "kitName": "theonekit-model-router",
  "modelRouter": {
    "enabled": true,
    "mode": "transparent",
    "modelMapping": {
      "claude-sonnet-4-6": {
        "provider": "kimi",
        "model": "kimi-k2.6"
      },
      "claude-haiku-4-5-20251001": {
        "provider": "kimi",
        "model": "kimi-k2.5"
      }
    },
    "excludeAgents": [],
    "failover": {
      "enabled": true,
      "perHopTimeoutSec": 120,
      "pipe": [
        {
          "provider": "kimi",
          "model": "kimi-k2.6"
        },
        {
          "provider": "opencode-go",
          "model": "glm-5.1"
        }
      ],
      "chain": {
        "opencode-go": "kimi",
        "kimi": "opencode-go",
        "codex": "kimi"
      },
      "fallbackToAnthropic": true
    }
  },
  "_origin": {
    "kit": "theonekit-model-router",
    "repository": "The1Studio/theonekit-model-router",
    "module": null,
    "protected": false
  }
}
