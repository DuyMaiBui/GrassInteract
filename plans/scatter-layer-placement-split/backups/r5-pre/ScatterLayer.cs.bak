#nullable enable
using Sirenix.OdinInspector;
using UnityEngine;
using UnityEngine.Experimental.Rendering;
using UnityEngine.Rendering;

namespace GrassInteract
{
    /// <summary>
    /// Per-LOD mesh + maximum camera distance pair.
    /// Used by <see cref="ScatterLayer.Lods"/> to unify LOD data for both Grass and Mesh kinds.
    /// The LOD is active when camera distance &lt;= <see cref="maxDistance"/>. LOD0 should have
    /// the smallest maxDistance (highest detail, close range); the last entry covers all remaining
    /// distances.
    /// </summary>
    [System.Serializable]
    public struct ScatterLod
    {
        [Tooltip("Mesh for this LOD level. LOD0 = highest detail.")]
        public Mesh? mesh;

        [Tooltip("Maximum camera distance (metres) at which this LOD is still active. " +
                 "The last LOD covers all remaining distances beyond the previous entry.")]
        [Min(0f)]
        public float maxDistance;
    }

    /// <summary>
    /// Genre-neutral scatter layer: a top-down R8 density map plus placement parameters. The
    /// <see cref="ScatterKind"/> field selects the render path — Grass uses the existing
    /// <see cref="GrassCpuEngine"/>/<see cref="GrassGpuEngine"/> pipeline; Mesh is declared for
    /// Phase 3.
    ///
    /// Instances of this type are sub-assets of <see cref="TerrainScatterConfig"/>; do NOT create
    /// directly via <c>Assets &gt; Create</c>. Use
    /// <see cref="TerrainScatterConfig.CreateLayer"/> instead.
    ///
    /// SSOT: every per-layer concern lives here — placement (bounds, density, scatter count, seed,
    /// masks), LOD meshes (via <see cref="Lods"/>), render material, shadow mode, wind tunables,
    /// bend/trample tunables, and AABB headroom. No external render-config sidecar.
    /// </summary>
    public class ScatterLayer : ScriptableObject
    {
        // ── Kind ──────────────────────────────────────────────────────────────

        /// <summary>Render kind: determines which engine handles this layer.</summary>
        public enum ScatterKind
        {
            /// <summary>Grass blades — rendered via GrassCpuEngine / GrassGpuEngine.</summary>
            Grass,

            /// <summary>Static mesh props — Phase 3. Fields declared but engine not yet implemented.</summary>
            Mesh,
        }

        [BoxGroup("Kind")]
        [Tooltip("Render kind for this layer. Grass = existing blade pipeline. " +
                 "Mesh = static prop pipeline (Phase 3 — no-op this phase; logs a skip message at build time).")]
        [SerializeField] private ScatterKind kind = ScatterKind.Grass;

        // ── Deform (wind + interactors) ────────────────────────────────────────

        /// <summary>
        /// Controls per-layer wind sway and interactor lean for this scatter layer.
        /// Auto: Grass layers deform (ON); Mesh layers are static (OFF).
        /// On:   Force deform regardless of kind (mesh props sway like grass).
        /// Off:  Force static regardless of kind (even grass can be made static).
        /// </summary>
        public enum DeformMode
        {
            /// <summary>
            /// Auto-resolve: Grass kind = deform ON (existing behaviour, byte-stable).
            /// Mesh kind = deform OFF (static props, existing behaviour).
            /// </summary>
            Auto,

            /// <summary>Deform ON for this layer regardless of kind.</summary>
            On,

            /// <summary>Deform OFF for this layer regardless of kind.</summary>
            Off,
        }

        [BoxGroup("Kind")]
        [Tooltip(
            "Controls wind sway and interactor lean for this layer.\n" +
            "Auto: Grass = ON (existing behaviour), Mesh = OFF (static).\n" +
            "On:   Force deform regardless of kind — mesh props sway + lean like grass.\n" +
            "Off:  Force static regardless of kind — even grass can be made static.")]
        [SerializeField] private DeformMode deformMode = DeformMode.Auto;

        // ── Authored instances ─────────────────────────────────────────────────

        [BoxGroup("Authored Instances")]
        [Tooltip("When true, this layer uses the AuthoredInstances sidecar as the canonical source " +
                 "of instance positions. The density map role flips from count-multiplier to " +
                 "placement mask (where Place-brush strokes are allowed). " +
                 "When false (default), the existing procedural TargetInstances scatter is used.")]
        [SerializeField] private bool hasAuthoredInstances = false;

        [BoxGroup("Authored Instances")]
        [Tooltip("Sub-asset holding all authored per-instance records for this layer. " +
                 "Created automatically when HasAuthoredInstances is first enabled. " +
                 "Do NOT assign manually — use the inspector toggle.")]
        [SerializeField] private AuthoredInstancesData? authoredInstances;

        [BoxGroup("Authored Instances")]
        [Tooltip("Minimum spacing (metres) between placed instances during a Place-brush stroke. " +
                 "Used for Poisson-disk candidate generation. Lower values = denser placement. " +
                 "Has no effect when HasAuthoredInstances = false.")]
        [Range(0.05f, 5f)]
        [SerializeField] private float placeSpacing = 0.5f;

        // ── Density ───────────────────────────────────────────────────────────

        [BoxGroup("Density")]
        [Tooltip("Readable, uncompressed R8 density map painted by the Grass Painter. White = full density, " +
                 "black = no instances. Sampled bilinearly across the field rect. " +
                 "When HasAuthoredInstances = true, this map acts as a placement mask only (not a count-multiplier).")]
        [SerializeField] private Texture2D? densityMap;

        [BoxGroup("Density")]
        [HideIf(nameof(hasAuthoredInstances))]
        [InfoBox("DEPRECATED. Authored layers ignore this field. " +
                 "Run Tools / GrassInteract / Bake Procedural Layer to Authored to migrate.",
                 InfoMessageType.Warning)]
        [Min(1)]
        [Tooltip("DEPRECATED — kept for backwards compatibility on procedural layers. " +
                 "Authored layers (HasAuthoredInstances = true) ignore this field. " +
                 "Slated for removal in the next migration cycle. " +
                 "Use Tools / GrassInteract / Bake Procedural Layer to Authored to migrate.")]
        [System.Obsolete("Use HasAuthoredInstances + AuthoredInstancesData. Will be removed next cycle.")]
        [UnityEngine.Serialization.FormerlySerializedAs("targetInstances")]
        [SerializeField] private int targetInstances = 50000;

        // ── Placement ─────────────────────────────────────────────────────────

        [BoxGroup("Placement")]
        [Tooltip("World-space XZ size of the field, centered on the ScatterField transform.")]
        [SerializeField] private Vector2 fieldBounds = new Vector2(100f, 100f);

        [BoxGroup("Placement")]
        [SerializeField] private Vector2 scaleRange = new Vector2(0.8f, 1.2f);

        [BoxGroup("Placement")]
        [SerializeField] private int seed = 0;

        [BoxGroup("Placement")]
        [Tooltip("Colliders the placement raycast snaps instances onto (Terrain, mesh ground, plane). " +
                 "Instances with no hit fall back to the field-plane Y.")]
        [SerializeField] private LayerMask groundSnapMask = ~0;

        [BoxGroup("Placement")]
        [Tooltip("Placement is allowed only when the ground slope (deg) is within [x, y]. " +
                 "Default (0, 90) = no filter.")]
        [SerializeField] private Vector2 slopeRange = new Vector2(0f, 90f);

        // ── Splat mask ────────────────────────────────────────────────────────

        [BoxGroup("Placement")]
        [Header("Splat Mask (Phase 4)")]
        [Tooltip("Terrain alphamap layer index to use as placement mask (-1 = off). " +
                 "When >= 0, candidates are accepted only where SplatWeights[splatLayerIndex] >= splatThreshold.")]
        [SerializeField] private int splatLayerIndex = -1;

        [BoxGroup("Placement")]
        [Tooltip("Minimum splat weight required for placement when splatLayerIndex >= 0. Range [0, 1].")]
        [Range(0f, 1f)]
        [SerializeField] private float splatThreshold = 0.5f;

        // ── Orientation ───────────────────────────────────────────────────────

        [BoxGroup("Orientation")]
        [Tooltip("Per-layer uniform rotation offset applied to every instance after yaw and optional pitch/roll. " +
                 "Does NOT activate oriented mode on its own.")]
        [SerializeField] private Vector3 rotationOffsetEuler = Vector3.zero;

        [BoxGroup("Orientation")]
        [Tooltip("Per-instance random pitch (X-axis) range in degrees. (0,0) = no random pitch. " +
                 "Activates oriented mode (slot2 encodes octNormal+pitch+roll instead of hash).")]
        [SerializeField] private Vector2 randomPitchRange = Vector2.zero;

        [BoxGroup("Orientation")]
        [Tooltip("Per-instance random roll (Z-axis) range in degrees. (0,0) = no random roll. " +
                 "Activates oriented mode.")]
        [SerializeField] private Vector2 randomRollRange = Vector2.zero;

        [BoxGroup("Orientation")]
        [Tooltip("Align instance up-axis to terrain/surface normal. Activates oriented mode.")]
        [SerializeField] private bool alignToNormal = false;

        // ── Rendering (Grass) ─────────────────────────────────────────────────

        [BoxGroup("Rendering (Grass)")]
        [Tooltip("Grass-kind material (InstancedGrass / IndirectGrass shader). Used when kind = Grass. " +
                 "Mesh-kind uses meshMaterial below.")]
        [SerializeField] private Material? grassMaterial;

        [BoxGroup("Rendering (Grass)")]
        [Tooltip("Shadow casting for the grass. Requires the shader's ShadowCaster pass (included). " +
                 "Off is recommended for dense mobile grass.")]
        [SerializeField] private ShadowCastingMode shadowCastingMode = ShadowCastingMode.Off;

        // ── Wind ──────────────────────────────────────────────────────────────

        /// <summary>Wind model the GPU shader applies. CPU simulator keeps Sine regardless.</summary>
        public enum WindMode
        {
            /// <summary>Directional sin() wave per blade (legacy). Cheapest; matches CPU sim exactly.</summary>
            Sine,

            /// <summary>2-octave Perlin gust + ripple sampled in the vertex shader (GPU-only).</summary>
            Perlin,
        }

        [BoxGroup("Wind")]
        [Tooltip("Wind model. Sine = directional sin() wave (legacy, matches CPU sim). " +
                 "Perlin = 2-octave gust+ripple in the GPU shader (CPU sim still uses Sine).")]
        [SerializeField] private WindMode windMode = WindMode.Sine;

        [BoxGroup("Wind")]
        [Tooltip("Ambient wind direction in the XZ plane (auto-normalized when bound).")]
        [SerializeField] private Vector2 windDirection = new Vector2(1f, 0f);

        [BoxGroup("Wind")]
        [Range(0f, 2f)]
        [Tooltip("Horizontal sway amplitude at the blade tip, in metres. Scales by height so roots stay put.")]
        [SerializeField] private float windStrength = 0.15f;

        [BoxGroup("Wind")]
        [Range(0f, 5f)]
        [ShowIf("windMode", WindMode.Sine)]
        [Tooltip("Sine mode: sway oscillation speed (cycles scale with _Time).")]
        [SerializeField] private float windFrequency = 1.2f;

        [BoxGroup("Wind")]
        [Range(0.01f, 2f)]
        [ShowIf("windMode", WindMode.Sine)]
        [Tooltip("Sine mode: spatial noise scale — how quickly the gust phase varies across the field.")]
        [SerializeField] private float windNoiseScale = 0.25f;

        [BoxGroup("Wind")]
        [Range(0.005f, 0.5f)]
        [ShowIf("windMode", WindMode.Perlin)]
        [Tooltip("Perlin mode: spatial frequency of the slow gust octave (smaller = larger patches).")]
        [SerializeField] private float windGustScale = 0.05f;

        [BoxGroup("Wind")]
        [Range(0.05f, 2f)]
        [ShowIf("windMode", WindMode.Perlin)]
        [Tooltip("Perlin mode: spatial frequency of the fast ripple octave.")]
        [SerializeField] private float windRippleScale = 0.4f;

        [BoxGroup("Wind")]
        [Range(0f, 3f)]
        [ShowIf("windMode", WindMode.Perlin)]
        [Tooltip("Perlin mode: scroll speed of the gust octave (metres/sec along _WindDir).")]
        [SerializeField] private float windGustSpeed = 0.3f;

        [BoxGroup("Wind")]
        [Range(0f, 5f)]
        [ShowIf("windMode", WindMode.Perlin)]
        [Tooltip("Perlin mode: scroll speed of the ripple octave (metres/sec along _WindDir).")]
        [SerializeField] private float windRippleSpeed = 1.5f;

        [BoxGroup("Wind")]
        [Range(0f, 1f)]
        [ShowIf("windMode", WindMode.Perlin)]
        [Tooltip("Perlin mode: how much the ripple octave contributes on top of the gust (0 = gust only).")]
        [SerializeField] private float windRippleWeight = 0.35f;

        // ── Trample ───────────────────────────────────────────────────────────

        [BoxGroup("Trample")]
        [Range(0f, 4f)]
        [Tooltip("Lateral lean amplitude at the blade tip, in metres, at full interactor magnitude. The blade " +
                 "leans AWAY from the interactor — direction + magnitude are computed by GrassBendSimulator " +
                 "(C#). Keep near the footprint scale so the lean stays contained. 0 = no lean.")]
        [SerializeField] private float bendStrength = 0.7f;

        [BoxGroup("Trample")]
        [Range(0f, 1f)]
        [Tooltip("Height loss at full interactor magnitude (0..1), consumed by GrassBendSimulator (C#). Mats " +
                 "the trampled core straight DOWN, so the most-trampled blades read as pressed flat, not " +
                 "merely leaned.")]
        [SerializeField] private float flatten = 0.5f;

        [BoxGroup("Trample")]
        [Min(0f)]
        [Tooltip("Recovery speed (metres/second of upright restoration) consumed by GrassBendSimulator (C#). " +
                 "How fast a leaned blade returns toward upright once no interactor is in range.")]
        [SerializeField] private float recoveryRate = 4f;

        // ── Bounds ────────────────────────────────────────────────────────────

        [BoxGroup("Bounds")]
        [Tooltip("Unscaled height (metres) of the LOD0 blade mesh. The Tools ▸ GrassInteract ▸ Build " +
                 "Blade Meshes generator produces 1 m blades. Update this if you swap in taller meshes.")]
        [Min(0.01f)]
        [SerializeField] private float maxBladeHeight = 1f;

        [BoxGroup("Bounds")]
        [Tooltip("Extra headroom (metres) added to the field-wide AABB beyond the scaled blade height, to cover " +
                 "wind/trample deform so bent blades are never frustum-culled. Also applied as lateral padding.")]
        [Min(0f)]
        [SerializeField] private float bendHeadroom = 1f;

        // ── GPU-Driven ────────────────────────────────────────────────────────

        [BoxGroup("GPU-Driven")]
        [Min(1)]
        [Tooltip("World-space XZ cell size (metres) for the GPU-driven spatial grid. Smaller = finer culling " +
                 "granularity but more GPU overhead; 8–16 m is recommended for typical grass densities.")]
        [SerializeField] private int chunkSize = 16;

        // ── LOD / Render ──────────────────────────────────────────────────────

        [BoxGroup("LOD & Render")]
        [Tooltip("Per-LOD mesh + switch distance pairs. LOD0 (highest detail) first.\n" +
                 "For Grass: populates the blade LOD meshes.\n" +
                 "For Mesh: populates the prop LOD meshes.\n" +
                 "maxDistance = the farthest camera distance (metres) at which this LOD is still used.")]
        [SerializeField] private ScatterLod[] lods = System.Array.Empty<ScatterLod>();

        [BoxGroup("LOD & Render")]
        [Tooltip("Material for Mesh-kind instances (ScatterInstanced shader).")]
        [SerializeField] private Material? meshMaterial;

        // ── Colliders ─────────────────────────────────────────────────────────

        [BoxGroup("Colliders")]
        [Tooltip("Generate a MeshCollider GameObject for EVERY instance of this layer (Play mode only). " +
                 "Heavy for large counts — intended for moderate prop layers.")]
        [SerializeField] private bool generateColliders = false;

        [BoxGroup("Colliders")]
        [Tooltip("Custom collider mesh applied to every instance. " +
                 "If null, falls back to lods[0].mesh (Mesh kind) or the grass LOD0 mesh (Grass kind).")]
        [SerializeField] private Mesh? colliderMesh;

        [BoxGroup("Colliders")]
        [Tooltip("Use a convex MeshCollider (required for non-kinematic Rigidbody interaction).")]
        [SerializeField] private bool colliderConvex = false;

        // ── Public accessors ──────────────────────────────────────────────────

        public ScatterKind Kind => this.kind;

        /// <summary>
        /// True when this layer should apply wind sway + interactor lean deform in the GPU shader.
        /// </summary>
        public bool InteractsWithDeform =>
            this.deformMode == DeformMode.On ||
            (this.deformMode == DeformMode.Auto && this.kind == ScatterKind.Grass);

        /// <summary>
        /// When true, this layer is driven by authored per-instance data rather than procedural scatter.
        /// The density map acts as a placement mask; TargetInstances is ignored.
        /// </summary>
        public bool HasAuthoredInstances => this.hasAuthoredInstances;

        /// <summary>
        /// Returns the placement strategy for this layer. Dispatches on the concrete runtime type.
        /// DensityScatterLayer / InstanceScatterLayer override to return their respective strategies directly.
        /// Unknown concrete types (un-migrated legacy sub-assets) throw InvalidOperationException.
        /// </summary>
        public virtual IScatterPlacement CreatePlacement() => this switch
        {
            InstanceScatterLayer instance => new InstancePlacement(instance),
            DensityScatterLayer  density  => new DensityPlacement(density),
            _                             => throw new System.InvalidOperationException(
                $"ScatterLayer '{this.name}' has placement type '{this.GetType().Name}' that is not a known concrete subclass. " +
                $"Run Tools / GrassInteract / Migrate / ScatterLayer Assets - Typed to migrate legacy assets."),
        };

        /// <summary>
        /// The authored-instances sidecar sub-asset. Non-null only when HasAuthoredInstances is true
        /// and the user has confirmed sidecar creation in the inspector.
        /// </summary>
        public AuthoredInstancesData? AuthoredInstances => this.authoredInstances;

        /// <summary>
        /// Minimum spacing (metres) between placed instances during a Place-brush stroke.
        /// Used by ScatterBrush for Poisson-disk candidate generation.
        /// Only meaningful when HasAuthoredInstances = true.
        /// </summary>
        public float PlaceSpacing => this.placeSpacing;

        public Texture2D? DensityMap => this.densityMap;

#pragma warning disable 0618 // Accessor is the sanctioned read-path for the [Obsolete] field during migration.
        public int TargetInstances => this.targetInstances;
#pragma warning restore 0618
        public Vector2 FieldBounds => this.fieldBounds;
        public Vector2 ScaleRange => this.scaleRange;
        public int Seed => this.seed;
        public LayerMask GroundSnapMask => this.groundSnapMask;

        // ── Unified LOD accessors ─────────────────────────────────────────────

        /// <summary>Raw LOD entries. LOD0 = highest detail.</summary>
        public ScatterLod[] Lods => this.lods;

        /// <summary>
        /// Ordered array of LOD meshes (LOD0 first) derived from <see cref="lods"/>.
        /// Returns empty when <see cref="lods"/> is empty.
        /// </summary>
        public Mesh[] LodMeshes
        {
            get
            {
                var meshes = new Mesh[this.lods.Length];
                for (int i = 0; i < this.lods.Length; ++i)
                    meshes[i] = this.lods[i].mesh!;
                return meshes;
            }
        }

        /// <summary>
        /// Ordered array of LOD switch distances (metres).
        /// Length = <see cref="lods"/>.Length - 1.
        /// </summary>
        public float[] LodMaxDistances
        {
            get
            {
                int distCount = Mathf.Max(0, this.lods.Length - 1);
                var dists = new float[distCount];
                for (int i = 0; i < distCount; ++i)
                    dists[i] = this.lods[i].maxDistance;
                return dists;
            }
        }

        // ── Rendering (Grass) accessors ───────────────────────────────────────

        /// <summary>Grass-kind material (InstancedGrass / IndirectGrass shader).</summary>
        public Material? GrassMaterial => this.grassMaterial;

        /// <summary>Shadow casting mode for the grass.</summary>
        public ShadowCastingMode ShadowCastingMode => this.shadowCastingMode;

        // ── Wind accessors ────────────────────────────────────────────────────

        /// <summary>Wind model — Sine (legacy, CPU-parity) or Perlin (GPU-only 2-octave gust+ripple).</summary>
        public WindMode Mode => this.windMode;

        /// <summary>Ambient wind direction in the XZ plane (auto-normalized when bound).</summary>
        public Vector2 WindDirection => this.windDirection;

        /// <summary>Horizontal sway amplitude at the blade tip, in metres.</summary>
        public float WindStrength => this.windStrength;

        /// <summary>Sine mode: sway oscillation speed.</summary>
        public float WindFrequency => this.windFrequency;

        /// <summary>Sine mode: spatial noise scale — per-blade phase variation.</summary>
        public float WindNoiseScale => this.windNoiseScale;

        /// <summary>Perlin mode: spatial frequency of the slow gust octave.</summary>
        public float WindGustScale => this.windGustScale;

        /// <summary>Perlin mode: spatial frequency of the fast ripple octave.</summary>
        public float WindRippleScale => this.windRippleScale;

        /// <summary>Perlin mode: scroll speed of the gust octave.</summary>
        public float WindGustSpeed => this.windGustSpeed;

        /// <summary>Perlin mode: scroll speed of the ripple octave.</summary>
        public float WindRippleSpeed => this.windRippleSpeed;

        /// <summary>Perlin mode: ripple-on-gust mix amount.</summary>
        public float WindRippleWeight => this.windRippleWeight;

        // ── Trample accessors ─────────────────────────────────────────────────

        /// <summary>Lateral lean amplitude at the blade tip at full interactor magnitude.</summary>
        public float BendStrength => this.bendStrength;

        /// <summary>Height loss at full interactor magnitude (0..1).</summary>
        public float Flatten => this.flatten;

        /// <summary>Recovery speed (metres/second of upright restoration).</summary>
        public float RecoveryRate => this.recoveryRate;

        // ── Bounds accessors ──────────────────────────────────────────────────

        /// <summary>Unscaled height (metres) of the LOD0 blade mesh.</summary>
        public float MaxBladeHeight => this.maxBladeHeight;

        /// <summary>Extra headroom (metres) added to the field-wide AABB beyond the scaled blade height.</summary>
        public float BendHeadroom => this.bendHeadroom;

        // ── GPU-Driven accessors ──────────────────────────────────────────────

        /// <summary>World-space XZ cell size (metres) for the GPU-driven spatial grid.</summary>
        public int ChunkSize => this.chunkSize;

        public Material? MeshMaterial => this.meshMaterial;

        public bool GenerateColliders => this.generateColliders;
        public Mesh? ColliderMesh => this.colliderMesh;
        public bool ColliderConvex => this.colliderConvex;

        // ── Phase 4 accessors ─────────────────────────────────────────────────

        /// <summary>Slope range [minDeg, maxDeg] within which placement is allowed.</summary>
        public Vector2 SlopeRange => this.slopeRange;

        /// <summary>Terrain alphamap layer index for splat-mask filtering. -1 = off.</summary>
        public int SplatLayerIndex => this.splatLayerIndex;

        /// <summary>Minimum splat weight for placement when SplatLayerIndex >= 0.</summary>
        public float SplatThreshold => this.splatThreshold;

        /// <summary>Uniform rotation offset (Euler degrees) applied to every instance.</summary>
        public Vector3 RotationOffsetEuler => this.rotationOffsetEuler;

        /// <summary>Per-instance random pitch (X-axis) range in degrees.</summary>
        public Vector2 RandomPitchRange => this.randomPitchRange;

        /// <summary>Per-instance random roll (Z-axis) range in degrees.</summary>
        public Vector2 RandomRollRange => this.randomRollRange;

        /// <summary>Align instance up-axis to terrain/surface normal.</summary>
        public bool AlignToNormal => this.alignToNormal;

        /// <summary>
        /// True when per-instance oriented packing is needed in the GPU buffers.
        /// Activated by alignToNormal or non-zero pitch/roll ranges.
        /// </summary>
        public bool IsOriented => this.alignToNormal
            || this.randomPitchRange != Vector2.zero
            || this.randomRollRange  != Vector2.zero;

        // ── Validation ────────────────────────────────────────────────────────

        /// <summary>
        /// Validates the layer. Returns false + a human-readable reason on the first problem found.
        /// </summary>
        public virtual bool Validate(out string error)
        {
            // Authored layers don't require a density map — the sidecar IS the source of truth.
            // The density map (when present) becomes a paint mask, optional.
            bool isAuthored = this.hasAuthoredInstances;

            if (this.densityMap == null)
            {
                if (isAuthored)
                {
                    // Authored layer with no density map is valid; skip remaining density-map checks.
                    error = string.Empty;
                    return this.ValidateAuthoredAndCommon(out error);
                }
                error = "DensityMap is not assigned.";
                return false;
            }

            if (!this.densityMap.isReadable)
            {
                error = $"DensityMap '{this.densityMap.name}' is not readable. Enable Read/Write in its " +
                        "import settings (the Grass Painter can fix this).";
                return false;
            }

            if (GraphicsFormatUtility.IsCompressedFormat(this.densityMap.graphicsFormat))
            {
                error = $"DensityMap '{this.densityMap.name}' is compressed. Use an uncompressed single-" +
                        "channel format (R8) so GetPixelBilinear is exact and reproducible.";
                return false;
            }

            if (this.kind == ScatterKind.Grass)
            {
                if (this.grassMaterial == null)
                {
                    error = "GrassMaterial is not assigned (required for kind = Grass).";
                    return false;
                }
            }

            if (this.scaleRange.x <= 0f || this.scaleRange.y < this.scaleRange.x)
            {
                error = $"ScaleRange ({this.scaleRange}) must be positive and non-decreasing.";
                return false;
            }

            if (this.fieldBounds.x <= 0f || this.fieldBounds.y <= 0f)
            {
                error = $"FieldBounds ({this.fieldBounds}) must be positive.";
                return false;
            }

            error = string.Empty;
            return true;
        }

        /// <summary>
        /// Common-tail validation reused by the authored-layer null-density path so it shares
        /// material / scale / fieldBounds checks without duplicating density-map logic.
        /// </summary>
        private bool ValidateAuthoredAndCommon(out string error)
        {
            if (this.kind == ScatterKind.Grass && this.grassMaterial == null)
            {
                error = "GrassMaterial is not assigned (required for kind = Grass).";
                return false;
            }
            if (this.scaleRange.x <= 0f || this.scaleRange.y < this.scaleRange.x)
            {
                error = $"ScaleRange ({this.scaleRange}) must be positive and non-decreasing.";
                return false;
            }
            if (this.fieldBounds.x <= 0f || this.fieldBounds.y <= 0f)
            {
                error = $"FieldBounds ({this.fieldBounds}) must be positive.";
                return false;
            }
            error = string.Empty;
            return true;
        }

        // ── Editor-only integration ───────────────────────────────────────────

#if UNITY_EDITOR
        // Debounced via delayCall so dragging a slider coalesces N edits into 1 rebuild per frame.
        private bool rebuildQueued;

        private void OnValidate()
        {
            if (this.rebuildQueued) return;
            this.rebuildQueued = true;
            UnityEditor.EditorApplication.delayCall += this.DeferredNotify;
        }

        private void DeferredNotify()
        {
            this.rebuildQueued = false;
            if (this == null) return;
            this.NotifyChanged();
        }

        /// <summary>
        /// Triggers a fast-path rebuild on every enabled <see cref="ScatterField"/> that owns
        /// this layer (i.e. its Config.Layers contains this layer). Only the engine slot at the
        /// layer's index is rebuilt — no full-field teardown. The field's <c>rebuilding</c> flag
        /// prevents re-entry if the field is already rebuilding.
        /// </summary>
        internal void NotifyChanged()
        {
            var fields = UnityEngine.Object.FindObjectsByType<ScatterField>(UnityEngine.FindObjectsSortMode.None);
            foreach (var f in fields)
            {
                if (f == null || !f.isActiveAndEnabled || f.Config == null) continue;
                int idx = -1;
                for (int i = 0; i < f.Config.Layers.Count; ++i)
                {
                    if (f.Config.Layers[i] == this) { idx = i; break; }
                }
                if (idx < 0) continue;

                // Capture idx by value for the delegate — do NOT capture the layer reference itself
                // because the index is re-resolved here at the time of the callback registration.
                int capturedIdx = idx;
                UnityEditor.EditorApplication.delayCall += () =>
                {
                    if (f != null && f.isActiveAndEnabled)
                        f.RebuildLayer(capturedIdx);
                };
            }
        }
#endif
    }
}
