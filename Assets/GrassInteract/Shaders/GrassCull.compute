// GrassCull.compute
// Phase 3: Compute A — chunk culling kernel.
// Phase 4: Compute B — per-blade cull + LOD bucketing kernel.
//
// Kernel index 0: ChunkCull   — culls N chunks against frustum + distance; appends visible IDs.
// Kernel index 1: WriteArgsB  — reads the CopyCount result and writes DispatchIndirect args for B.
// Kernel index 2: BladeCull   — dispatched indirectly (one group per visible chunk); per-blade
//                               frustum + distance test; buckets surviving global blade indices
//                               into visibleLod0 / visibleLod1 / visibleLod2.

#pragma kernel ChunkCull
#pragma kernel WriteArgsB
#pragma kernel BladeCull

// ─── Structs ────────────────────────────────────────────────────────────────
// ChunkAabb layout must match the C# blittable struct EXACTLY:
//   float3 min  (12 B) then float3 max (12 B) = 24 B total.
struct ChunkAabb
{
    float3 mn;  // min
    float3 mx;  // max
};

// BladeInstance layout must match the C# blittable struct EXACTLY:
//   float3 posWS (12 B) + uint packedYawScale (4 B) + uint hash (4 B) = 20 B total.
struct BladeInstance
{
    float3 posWS;
    uint   packedYawScale;
    uint   hash;
};

// ChunkRange layout must match the C# blittable struct EXACTLY:
//   uint start (4 B) + uint count (4 B) = 8 B total.
struct ChunkRange
{
    uint start;
    uint count;
};

// ─── ChunkCull bindings ──────────────────────────────────────────────────────
StructuredBuffer<ChunkAabb>     chunkAabbs;         // one AABB per chunk
uint                            chunkCount;         // total number of chunks
float4                          frustumPlanes[6];   // xyz=inward normal, w=distance (GeometryUtility convention)
float3                          camPosWS;           // world-space camera position
float                           maxCullSqrDistance; // beyond this squared distance → reject

AppendStructuredBuffer<uint>    visibleChunks;      // output: surviving chunk IDs

// ─── WriteArgsB bindings ─────────────────────────────────────────────────────
// visibleCount is a Raw buffer (ByteAddressBuffer) — CopyCount destination must be Raw or IndirectArguments.
// ByteAddressBuffer reads 32-bit words at byte offset. Load(0) reads word at byte offset 0.
ByteAddressBuffer               visibleCount;       // [0] = count written by CopyCount
RWStructuredBuffer<uint>        dispatchArgsB;      // [0]=groupsX [1]=1 [2]=1 for DispatchIndirect

// ─── BladeCull bindings ──────────────────────────────────────────────────────
// visibleChunkCount is read from the same count buffer WriteArgsB used (no CPU readback needed).
// BladeCull reads visibleCount[0] as an upper-bound guard so out-of-range groups exit early.
StructuredBuffer<BladeInstance> blades;             // all blade instances (sorted by chunk)
StructuredBuffer<ChunkRange>    chunkRanges;        // one ChunkRange per chunk
// visibleChunks is declared above as AppendStructuredBuffer for ChunkCull.
// BladeCull reads visibleChunks as a plain StructuredBuffer — HLSL allows re-binding under a different
// register name. However since HLSL forbids two names for the same slot in one kernel, we declare a
// separate read view named visibleChunksRead.
StructuredBuffer<uint>          visibleChunksRead;  // read-only view of the visibleChunks buffer

// LOD bucketing thresholds (squared distances, passed from CPU — sourced from ScatterLayer.LodMaxDistances).
float                           lod0MaxSqrDist;     // <= this → LOD 0
float                           lod1MaxSqrDist;     // <= this → LOD 1; else → LOD 2

// Per-blade frustum-cull margin (metres). The per-blade test below uses only the blade ROOT point,
// which has zero vertical extent — so a blade whose root is just outside a plane but whose HEAD/tip is
// still visible would be wrongly culled. Treat each blade as a sphere of radius bladeCullMargin at its
// root and pad every plane by it. SSOT: CPU sets this = MaxBladeHeight*scaleMax + BendHeadroom (+ extra),
// the SAME expression the chunk-AABB baker uses for bladeReachY (its Y inflation) — so per-blade and
// per-chunk inflation stay in lockstep on the near/far axis. 0 = original point-test behaviour.
//
// Isotropic sphere — intentional conservatism (both safe, never produces holes):
//  • Lateral planes are padded by this Y-reach, which is larger than the baker's smaller lateralPad
//    (= maxScale + BendHeadroom). Over-keeps a thin ring of blades at lateral frustum edges; the
//    rasterizer clips the truly off-screen ones. Cheaper than a second lateral uniform.
//  • Near plane: blades whose root is up to bladeCullMargin BEHIND the near plane pass this test
//    (a real grass blade there has no visible head); they are left to clip-space culling / the
//    distance reject below. Acceptable for a single-scalar sphere model.
float                           bladeCullMargin;

// Three separate AppendStructuredBuffers — HLSL has no array of AppendStructuredBuffer.
AppendStructuredBuffer<uint>    visibleLod0;        // global blade indices for LOD 0
AppendStructuredBuffer<uint>    visibleLod1;        // global blade indices for LOD 1
AppendStructuredBuffer<uint>    visibleLod2;        // global blade indices for LOD 2

// ─── ChunkCull kernel ────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void ChunkCull(uint3 id : SV_DispatchThreadID)
{
    uint chunkId = id.x;
    if (chunkId >= chunkCount)
        return;

    ChunkAabb aabb = chunkAabbs[chunkId];

    // 1. Empty-sentinel test: baked empty cells have min > max.
    if (aabb.mn.x > aabb.mx.x)
        return;

    // 2. Distance reject — nearest point of AABB to camPos, squared distance.
    //    Clamp camPos into [mn, mx] per axis → nearest point on or in the box.
    float3 nearest;
    nearest.x = clamp(camPosWS.x, aabb.mn.x, aabb.mx.x);
    nearest.y = clamp(camPosWS.y, aabb.mn.y, aabb.mx.y);
    nearest.z = clamp(camPosWS.z, aabb.mn.z, aabb.mx.z);

    float3 delta = camPosWS - nearest;
    float sqrDist = dot(delta, delta);
    if (sqrDist > maxCullSqrDistance)
        return;

    // 3. Frustum reject — positive-vertex (n-vertex) test against each of 6 planes.
    //    Convention (GeometryUtility): dot(plane.xyz, p) + plane.w >= 0 means INSIDE.
    //    For AABB vs plane: use the positive vertex (the corner that is most in the
    //    direction of the plane normal). If the positive vertex is outside (< 0), the
    //    entire box is outside that plane → cull.
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 plane = frustumPlanes[i];
        // Positive vertex: for each axis, choose the component that maximises dot with normal.
        float3 pVertex;
        pVertex.x = (plane.x >= 0.0f) ? aabb.mx.x : aabb.mn.x;
        pVertex.y = (plane.y >= 0.0f) ? aabb.mx.y : aabb.mn.y;
        pVertex.z = (plane.z >= 0.0f) ? aabb.mx.z : aabb.mn.z;

        // If the most-inward corner is outside this plane, the whole box is outside → cull.
        if (dot(plane.xyz, pVertex) + plane.w < 0.0f)
            return;
    }

    // 4. Survived all tests — append this chunk's ID.
    visibleChunks.Append(chunkId);
}

// ─── WriteArgsB kernel ───────────────────────────────────────────────────────
// Single-thread kernel; dispatch with (1,1,1) groups.
// Reads the count written by CopyCount and fills DispatchIndirect args for Compute B.
//
// PHASE 4 DESIGN: BladeCull uses one thread GROUP per visible CHUNK (grid-stride within the
// group over that chunk's blades). Therefore groupsX = visibleChunkCount directly — one group
// per slot, not one group per batch-of-64. PHASE4_GROUP is 1u (not 64u) to express this.
// The Phase 3 harness was updated accordingly: dispatchArgsB[0] == M (not ceil(M/64)).
[numthreads(1, 1, 1)]
void WriteArgsB(uint3 id : SV_DispatchThreadID)
{
    // ByteAddressBuffer.Load(byteOffset) — offset 0 = first uint.
    uint count = visibleCount.Load(0);
    // One group per visible chunk → groupsX == count.
    dispatchArgsB[0] = count;
    dispatchArgsB[1] = 1u;
    dispatchArgsB[2] = 1u;
}

// ─── BladeCull kernel ────────────────────────────────────────────────────────
// Dispatched INDIRECTLY via DispatchComputeIndirect(dispatchArgsB) = [visibleChunkCount, 1, 1].
// One thread GROUP per visible chunk; 64 threads per group (GLES3.1-safe, covers typical chunk
// sizes without excessive loop iterations — a chunk of 256 blades needs 4 loops per thread).
//
// Per-thread:
//   1. Map SV_GroupID.x → slot in visibleChunksRead → chunkId.
//   2. Guard slot < visibleChunkCount (read from visibleCount buffer, no CPU readback).
//   3. Grid-stride loop over that chunk's [start, start+count) blades:
//      a. Per-blade frustum test (point vs 6 planes, GeometryUtility inward-normal convention).
//      b. sqrDist bucketing → LOD 0 / 1 / 2.
//      c. Append globalIndex to the correct AppendStructuredBuffer.
[numthreads(64, 1, 1)]
void BladeCull(uint3 groupId   : SV_GroupID,
               uint3 threadId  : SV_GroupThreadID)
{
    uint slot = groupId.x;

    // Guard: this group maps to a visible-chunk slot. visibleCount[0] holds the count of
    // surviving chunks from CopyCount. Read it to guard partial last groups (in practice
    // DispatchIndirect already gives exact group count, but the guard is cheap + correct).
    uint visChunkCount = visibleCount.Load(0);
    if (slot >= visChunkCount)
        return;

    uint chunkId = visibleChunksRead[slot];
    ChunkRange r = chunkRanges[chunkId];

    uint tid = threadId.x;

    // Grid-stride loop: each thread processes blades at indices tid, tid+64, tid+128, ...
    for (uint k = tid; k < r.count; k += 64u)
    {
        uint globalIdx = r.start + k;
        BladeInstance b = blades[globalIdx];
        float3 posWS = b.posWS;

        // ── Per-blade frustum test (point vs 6 planes) ────────────────────
        // GeometryUtility convention: dot(n, p) + w >= 0 → inside.
        bool inFrustum = true;
        [unroll]
        for (int i = 0; i < 6; i++)
        {
            float4 plane = frustumPlanes[i];
            // Pad by bladeCullMargin: treat the blade as a sphere of that radius at its root so a
            // root-outside / head-inside blade survives (mirrors the chunk-AABB Y/lateral inflation).
            if (dot(plane.xyz, posWS) + plane.w < -bladeCullMargin)
            {
                inFrustum = false;
                break;
            }
        }
        if (!inFrustum)
            continue;

        // ── Distance + LOD bucket ─────────────────────────────────────────
        float3 d = posWS - camPosWS;
        float sqrDist = dot(d, d);

        // Beyond the overall max cull distance → skip entirely.
        if (sqrDist > maxCullSqrDistance)
            continue;

        // Bucket into LOD 0, 1, or 2 by squared distance.
        if (sqrDist <= lod0MaxSqrDist)
            visibleLod0.Append(globalIdx);
        else if (sqrDist <= lod1MaxSqrDist)
            visibleLod1.Append(globalIdx);
        else
            visibleLod2.Append(globalIdx);
    }
}
