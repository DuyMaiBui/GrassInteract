// TerrainBrush.compute — height + splat + density compute kernels.
// All kernels operate on the per-tile working RenderTexture(s).
// Dispatch: ceil(RT_RES / 8) × ceil(RT_RES / 8) × 1 thread groups.
//
// Refactored in Batch 2 to use BrushMask.hlsl for the per-texel weight.
// Kernel signatures / names preserved so TerrainBrushMathTests stays green.
// P3b: Density kernel added — folds DensityPaintGPU paint/erase/smooth math
//      over BrushMask.hlsl weight. DensityBrushMathTests is the contract.

#pragma kernel RaiseLower
#pragma kernel Smooth
#pragma kernel Flatten
#pragma kernel PaintDensity
#pragma kernel PaintAlphamap

#include "BrushMask.hlsl"

// ── Shared parameters ────────────────────────────────────────────────────────

/// Height working texture (RFloat, read+write). Normalized [0,1].
RWTexture2D<float>  _HeightRT;

/// Brush center in tile UV space [0,1].
float2 _BrushCenterUV;

/// Brush radius in UV space (radius_m / TILE_SIZE_M).
float  _BrushRadiusUV;

/// Stroke strength [0,1].
float  _Strength;

/// Resolution of the working RT (texels per edge = BRUSH_RT_RES).
int    _RTRes;

/// 1 = use falloff LUT (_FalloffLUT), 0 = use inline cubic falloff.
int    _UseFalloffLUT;

// ── RaiseLower parameters ────────────────────────────────────────────────────

/// +1 = raise, -1 = lower.
float _RaiseSign;

/// Set Height target, normalized [0,1] in this tile's [minHeight,maxHeight] range (pre-clamped
/// on the CPU). Raise treats it as a ceiling (never pushes above it); Lower as a floor (never
/// below it). The stroke converges toward this height instead of running away unbounded.
float _SetHeightTarget;

// ── Flatten parameters ───────────────────────────────────────────────────────

/// Target normalized height for Flatten kernel.
float _FlattenTarget;

// ── PaintAlphamap parameters (TerrainPalette path) ───────────────────────────

/// Per-tile alphamap working RT (RGBA float, read+write) — channels carry palette weights.
/// Caller binds the alphamap (k = ActivePaletteIndex / 4); the kernel writes channel
/// (ActivePaletteIndex % 4) and proportionally rebalances the other channels so the
/// per-texel weights stay ≤ 1 (paint mode).
RWTexture2D<float4> _AlphamapRT;

/// Channel [0,3] within _AlphamapRT to paint (= ActivePaletteIndex % 4).
int _AlphamapChannel;

/// Alphamap paint mode: 0 = Paint (add + renormalize), 1 = Erase (subtract from active channel).
int _AlphamapMode;

// ── PaintDensity parameters ───────────────────────────────────────────────────

/// Density working texture (RFloat, read+write). Normalized [0,1].
RWTexture2D<float> _DensityRT;

/// Density paint mode: 0 = Paint (add), 1 = Erase (subtract), 2 = Smooth (blur).
int _DensityMode;

/// Seam-aware density Smooth: a straddled neighbour tile's working density RT bound per
/// direction so the box blur reads across the shared tile edge instead of clamping at the
/// border (mirror of the height Smooth seam handling — see the Smooth kernel notes above).
/// Unbound directions get a placeholder + flag 0 (never sampled) so the texture stays bound
/// for every PaintDensity dispatch (paint/erase included), as the kernel references them.
Texture2D<float> _NeighborDensityPosX;  int _HasNeighborDensityPosX;
Texture2D<float> _NeighborDensityNegX;  int _HasNeighborDensityNegX;
Texture2D<float> _NeighborDensityPosZ;  int _HasNeighborDensityPosZ;
Texture2D<float> _NeighborDensityNegZ;  int _HasNeighborDensityNegZ;

// ── PaintAlphamap Smooth parameters (TerrainPalette path) ────────────────────

/// Seam-aware alphamap Smooth: a straddled neighbour tile's working alphamap RT (same
/// alphamap index) bound per direction so the active-channel box blur reads across the
/// shared tile edge. Same placeholder/flag contract as the density neighbours above.
Texture2D<float4> _NeighborAlphaPosX;  int _HasNeighborAlphaPosX;
Texture2D<float4> _NeighborAlphaNegX;  int _HasNeighborAlphaNegX;
Texture2D<float4> _NeighborAlphaPosZ;  int _HasNeighborAlphaPosZ;
Texture2D<float4> _NeighborAlphaNegZ;  int _HasNeighborAlphaNegZ;

// ── Helpers ──────────────────────────────────────────────────────────────────

/// Smooth falloff: backward-compat CPU reference (kept for inline kernel path).
/// The BrushMask.hlsl BrushFalloffInline is the canonical implementation.
float BrushFalloff(float2 texelUV, float2 centerUV, float radiusUV)
{
    return BrushFalloffInline(texelUV, centerUV, radiusUV);
}

float2 TexelToUV(uint2 id)
{
    return TexelToUV_BM(id, _RTRes);
}

// ── Per-texel weight (one-liner via BrushMask.hlsl) ─────────────────────────

float TexelWeight(float2 uv)
{
    bool useLUT = (_UseFalloffLUT != 0);
    return BrushWeight(uv, _BrushCenterUV, _BrushRadiusUV, useLUT);
}

// ── RaiseLower kernel ────────────────────────────────────────────────────────
// Raises (+1) or lowers (-1) the height RT within the brush radius.

[numthreads(8, 8, 1)]
void RaiseLower(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _RTRes || (int)id.y >= _RTRes) return;

    float2 uv     = TexelToUV(id.xy);
    float  weight = TexelWeight(uv);
    if (weight <= 0.0f) return;

    float cur    = _HeightRT[id.xy];
    float delta  = _Strength * weight * _RaiseSign * 0.01f; // 0.01 keeps strokes gentle
    float raw    = cur + delta;
    float target = saturate(_SetHeightTarget);

    // Set Height clamp: Raise (+1) is a ceiling — only push up, never past the target, and never
    // pull down a vertex already above it. Lower (-1) is the mirror floor. The stroke therefore
    // converges to the target plateau instead of running away.
    float result;
    if (_RaiseSign > 0.0f) result = (cur < target) ? min(raw, target) : cur;
    else                   result = (cur > target) ? max(raw, target) : cur;

    _HeightRT[id.xy] = saturate(result);
}

// ── Smooth kernel ─────────────────────────────────────────────────────────────
// Box-blurs the height RT within the brush radius (radius-3 window). Seam-aware: when a
// neighbour tile's working texture is bound (the brush straddles that seam), samples that cross
// the tile border read the neighbour instead of being skipped — so the shared edge is averaged
// over the SAME neighbourhood on both tiles and the smoothed surface stays continuous across the
// seam (no kink, no crack). Neighbour working textures share _RTRes on an aligned grid, and the
// shared edge column/row is duplicated (tileA col _RTRes-1 == tileB col 0), so a +X overflow of d
// maps to neighbour column d. With no neighbour bound the sample is skipped, exactly reproducing
// the original single-tile box blur at true world borders.

Texture2D<float> _NeighborPosX;  int _HasNeighborPosX;
Texture2D<float> _NeighborNegX;  int _HasNeighborNegX;
Texture2D<float> _NeighborPosZ;  int _HasNeighborPosZ;
Texture2D<float> _NeighborNegZ;  int _HasNeighborNegZ;

// Resolves one neighbourhood tap. Returns false (caller skips, preserving the original behaviour)
// when the tap is outside this tile AND no neighbour is bound in that direction. Diagonal
// (both-axis) overflow with no in-tile component is skipped — the 4-tile-corner texel, negligible.
bool SampleNeighborhood(int2 nb, out float h)
{
    bool inX = (nb.x >= 0 && nb.x < _RTRes);
    bool inY = (nb.y >= 0 && nb.y < _RTRes);
    if (inX && inY) { h = _HeightRT[nb]; return true; }

    if (!inX && inY)
    {
        if (nb.x >= _RTRes && _HasNeighborPosX != 0)
        { h = _NeighborPosX.Load(int3(nb.x - (_RTRes - 1), nb.y, 0)); return true; }
        if (nb.x < 0 && _HasNeighborNegX != 0)
        { h = _NeighborNegX.Load(int3((_RTRes - 1) + nb.x, nb.y, 0)); return true; }
    }
    else if (inX && !inY)
    {
        if (nb.y >= _RTRes && _HasNeighborPosZ != 0)
        { h = _NeighborPosZ.Load(int3(nb.x, nb.y - (_RTRes - 1), 0)); return true; }
        if (nb.y < 0 && _HasNeighborNegZ != 0)
        { h = _NeighborNegZ.Load(int3(nb.x, (_RTRes - 1) + nb.y, 0)); return true; }
    }

    h = 0.0f;
    return false;
}

[numthreads(8, 8, 1)]
void Smooth(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _RTRes || (int)id.y >= _RTRes) return;

    float2 uv     = TexelToUV(id.xy);
    float  weight = TexelWeight(uv);
    if (weight <= 0.0f) return;

    float sum = 0.0f;
    float cnt = 0.0f;
    for (int dy = -3; dy <= 3; ++dy)
    {
        for (int dx = -3; dx <= 3; ++dx)
        {
            float h;
            if (SampleNeighborhood(int2(id.xy) + int2(dx, dy), h))
            {
                sum += h;
                cnt += 1.0f;
            }
        }
    }
    float avg = (cnt > 0.0f) ? (sum / cnt) : _HeightRT[id.xy];
    float cur = _HeightRT[id.xy];
    _HeightRT[id.xy] = lerp(cur, avg, _Strength * weight);
}

// ── Flatten kernel ────────────────────────────────────────────────────────────
// Pushes height towards _FlattenTarget within the brush radius.

[numthreads(8, 8, 1)]
void Flatten(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _RTRes || (int)id.y >= _RTRes) return;

    float2 uv     = TexelToUV(id.xy);
    float  weight = TexelWeight(uv);
    if (weight <= 0.0f) return;

    float cur = _HeightRT[id.xy];
    _HeightRT[id.xy] = lerp(cur, _FlattenTarget, _Strength * weight);
}

// ── PaintDensity kernel ────────────────────────────────────────────────────────
// Folds DensityPaintGPU paint/erase/smooth math over BrushMask.hlsl weight.
// Mirrors the three modes from the legacy shader path so DensityBrushMathTests
// (the contract) exercises identical math through this shared kernel.
//
// _DensityMode 0 = Paint  : add Strength * weight (clamped to [0,1])
// _DensityMode 1 = Erase  : subtract Strength * weight (clamped to [0,1])
// _DensityMode 2 = Smooth : lerp toward local 7×7 average by Strength * weight (seam-aware)

// Resolves one density neighbourhood tap. In-tile reads _DensityRT; an overflow into a bound
// neighbour reads that neighbour's RT (shared-edge remap, identical convention to the height
// SampleNeighborhood). Returns false (caller skips → original single-tile box blur) when the
// tap is outside this tile AND no neighbour is bound in that direction; diagonal overflow is
// skipped (negligible 4-tile-corner texel), matching the height seam handling.
bool SampleNeighborhoodDensity(int2 nb, out float d)
{
    bool inX = (nb.x >= 0 && nb.x < _RTRes);
    bool inY = (nb.y >= 0 && nb.y < _RTRes);
    if (inX && inY) { d = _DensityRT[nb]; return true; }

    if (!inX && inY)
    {
        if (nb.x >= _RTRes && _HasNeighborDensityPosX != 0)
        { d = _NeighborDensityPosX.Load(int3(nb.x - (_RTRes - 1), nb.y, 0)); return true; }
        if (nb.x < 0 && _HasNeighborDensityNegX != 0)
        { d = _NeighborDensityNegX.Load(int3((_RTRes - 1) + nb.x, nb.y, 0)); return true; }
    }
    else if (inX && !inY)
    {
        if (nb.y >= _RTRes && _HasNeighborDensityPosZ != 0)
        { d = _NeighborDensityPosZ.Load(int3(nb.x, nb.y - (_RTRes - 1), 0)); return true; }
        if (nb.y < 0 && _HasNeighborDensityNegZ != 0)
        { d = _NeighborDensityNegZ.Load(int3(nb.x, (_RTRes - 1) + nb.y, 0)); return true; }
    }

    d = 0.0f;
    return false;
}

[numthreads(8, 8, 1)]
void PaintDensity(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _RTRes || (int)id.y >= _RTRes) return;

    float2 uv     = TexelToUV(id.xy);
    float  weight = TexelWeight(uv);
    if (weight <= 0.0f) return;

    float cur   = _DensityRT[id.xy];
    float delta = _Strength * weight;

    if (_DensityMode == 0)
    {
        // Paint: accumulate density.
        _DensityRT[id.xy] = saturate(cur + delta);
    }
    else if (_DensityMode == 1)
    {
        // Erase: subtract density.
        _DensityRT[id.xy] = saturate(cur - delta);
    }
    else
    {
        // Smooth: seam-aware box-blur of the density RT spread across the BRUSH FOOTPRINT, not a
        // fixed ±3 texels. A ±3-texel window at BRUSH_RT_RES is below the perceptual threshold once
        // the RT is downsampled to DENSITY_RES and consumed by the sparse stochastic grass scatter
        // (DensityPlacement) — that blur was invisible, so Smooth appeared to do nothing on grass
        // even though the identical math is visible on the continuous splat blend. Spread a bounded
        // 7×7 tap grid over ~the brush radius via an integer stride so the averaged neighbourhood
        // actually spans the painted area. Taps crossing a tile edge read a bound neighbour's RT
        // (seam-aware, unchanged); the stride scales the reach, not the tap count (cost stays 49).
        const int HALF_TAPS = 3;                                            // 7×7 = 49 taps
        float radiusTexels  = _BrushRadiusUV * (float)_RTRes;
        int   stride        = max(1, (int)(radiusTexels / (float)HALF_TAPS)); // grid spans ~±radius
        float sum = 0.0f;
        float cnt = 0.0f;
        for (int ty = -HALF_TAPS; ty <= HALF_TAPS; ++ty)
        {
            for (int tx = -HALF_TAPS; tx <= HALF_TAPS; ++tx)
            {
                float d;
                if (SampleNeighborhoodDensity(int2(id.xy) + int2(tx, ty) * stride, d))
                {
                    sum += d;
                    cnt += 1.0f;
                }
            }
        }
        float avg = (cnt > 0.0f) ? (sum / cnt) : cur;
        _DensityRT[id.xy] = lerp(cur, avg, delta);
    }
}

// ── PaintAlphamap kernel ──────────────────────────────────────────────────────
// Phase 2b: writes the per-tile alphamap that owns the active TerrainPalette index.
// Mirrors the PaintSplat math (paint = accumulate + renormalize, erase = subtract)
// but on the channel selected by _AlphamapChannel instead of the fixed RGBA-to-layer
// SSOT. The C# caller picks the right alphamap RT (k = paletteIndex / 4) and channel
// (paletteIndex % 4); the kernel itself is identical for all four channels.
//
// Note: when the palette has more than 4 entries, every active palette layer lives on
// some alphamap. Painting touches ONLY the alphamap that owns the active layer; weights
// on the OTHER alphamaps are not normalised against this one (intentional — Unity-Terrain
// behaviour). The shader-side blend in TerrainPalette.hlsl handles cross-alphamap
// normalisation by dividing by the sum of all sampled weights.

/// Reads one channel from a float4 alphamap sample by index [0,3].
float AlphaChannel(float4 a, int channel)
{
    if (channel == 0) return a.x;
    if (channel == 1) return a.y;
    if (channel == 2) return a.z;
    return a.w;
}

/// When the active channel's new value pushes the per-texel total above 1, scales the OTHER
/// channels down proportionally so the sum stays ≤ 1 (the active channel is preserved). Shared
/// by Paint and Smooth so both honour the same ≤1 invariant. Total ≤ 1 is left untouched —
/// TerrainPalette.hlsl renormalises by the sum of sampled weights at blend time.
void RenormalizeAlphaOthers(inout float4 target, int channel)
{
    float total = target.x + target.y + target.z + target.w;
    if (total <= 1.0f) return;

    float activeVal = AlphaChannel(target, channel);
    float budget    = saturate(1.0f - activeVal);
    float otherSum  = total - activeVal;
    float scale     = (otherSum > 1e-6f) ? (budget / otherSum) : 0.0f;

    if (channel != 0) target.x *= scale;
    if (channel != 1) target.y *= scale;
    if (channel != 2) target.z *= scale;
    if (channel != 3) target.w *= scale;
}

// Resolves one alphamap neighbourhood tap (float4). Same shared-edge remap + skip contract as
// SampleNeighborhoodDensity, but over the RGBA alphamap RT. Used by the active-channel Smooth.
bool SampleNeighborhoodAlpha(int2 nb, out float4 a)
{
    bool inX = (nb.x >= 0 && nb.x < _RTRes);
    bool inY = (nb.y >= 0 && nb.y < _RTRes);
    if (inX && inY) { a = _AlphamapRT[nb]; return true; }

    if (!inX && inY)
    {
        if (nb.x >= _RTRes && _HasNeighborAlphaPosX != 0)
        { a = _NeighborAlphaPosX.Load(int3(nb.x - (_RTRes - 1), nb.y, 0)); return true; }
        if (nb.x < 0 && _HasNeighborAlphaNegX != 0)
        { a = _NeighborAlphaNegX.Load(int3((_RTRes - 1) + nb.x, nb.y, 0)); return true; }
    }
    else if (inX && !inY)
    {
        if (nb.y >= _RTRes && _HasNeighborAlphaPosZ != 0)
        { a = _NeighborAlphaPosZ.Load(int3(nb.x, nb.y - (_RTRes - 1), 0)); return true; }
        if (nb.y < 0 && _HasNeighborAlphaNegZ != 0)
        { a = _NeighborAlphaNegZ.Load(int3(nb.x, (_RTRes - 1) + nb.y, 0)); return true; }
    }

    a = float4(0, 0, 0, 0);
    return false;
}

[numthreads(8, 8, 1)]
void PaintAlphamap(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _RTRes || (int)id.y >= _RTRes) return;

    float2 uv     = TexelToUV(id.xy);
    float  weight = TexelWeight(uv);
    if (weight <= 0.0f) return;

    float4 alphas = _AlphamapRT[id.xy];
    float  paint  = _Strength * weight;
    float4 target = alphas;

    // Erase: subtract from the active channel; other channels untouched.
    if (_AlphamapMode == 1)
    {
        if (_AlphamapChannel == 0) target.x = saturate(target.x - paint);
        if (_AlphamapChannel == 1) target.y = saturate(target.y - paint);
        if (_AlphamapChannel == 2) target.z = saturate(target.z - paint);
        if (_AlphamapChannel == 3) target.w = saturate(target.w - paint);
        _AlphamapRT[id.xy] = target;
        return;
    }

    // Smooth: seam-aware box-blur of the ACTIVE channel only (active-channel-only contract).
    // Lerp the active channel toward its 7×7 neighbourhood average by Strength * weight; the
    // other channels are left as-is, then renormalised so the per-texel total stays ≤ 1. Softens
    // the active layer's coverage edge without disturbing the relative weights of the others.
    if (_AlphamapMode == 2)
    {
        float sum = 0.0f;
        float cnt = 0.0f;
        for (int dy = -3; dy <= 3; ++dy)
        {
            for (int dx = -3; dx <= 3; ++dx)
            {
                float4 na;
                if (SampleNeighborhoodAlpha(int2(id.xy) + int2(dx, dy), na))
                {
                    sum += AlphaChannel(na, _AlphamapChannel);
                    cnt += 1.0f;
                }
            }
        }
        float curActive = AlphaChannel(alphas, _AlphamapChannel);
        float avg       = (cnt > 0.0f) ? (sum / cnt) : curActive;
        float blended   = saturate(lerp(curActive, avg, paint));

        if (_AlphamapChannel == 0) target.x = blended;
        if (_AlphamapChannel == 1) target.y = blended;
        if (_AlphamapChannel == 2) target.z = blended;
        if (_AlphamapChannel == 3) target.w = blended;

        RenormalizeAlphaOthers(target, _AlphamapChannel);
        _AlphamapRT[id.xy] = target;
        return;
    }

    // Paint: accumulate into the active channel.
    if (_AlphamapChannel == 0) target.x = saturate(target.x + paint);
    if (_AlphamapChannel == 1) target.y = saturate(target.y + paint);
    if (_AlphamapChannel == 2) target.z = saturate(target.z + paint);
    if (_AlphamapChannel == 3) target.w = saturate(target.w + paint);

    // Renormalise: when paint pushes the total above 1, scale the OTHER channels down
    // proportionally so the sum stays ≤ 1. Active channel's new value is preserved.
    RenormalizeAlphaOthers(target, _AlphamapChannel);

    _AlphamapRT[id.xy] = target;
}
