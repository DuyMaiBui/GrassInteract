/*
 * ScatterStudioLight.uss — Light-skin palette overrides (Phase 5)
 *
 * All rules are scoped under .light, which is added to the root VisualElement by
 * ScatterStudioWindow when EditorGUIUtility.isProSkin == false.
 *
 * Load order: ScatterStudio.uss (layout + shared theme + .pro rules) is loaded first
 * by ScatterStudioWindow. The orchestrator loads this sheet as the second stylesheet
 * so its .light-scoped rules override the shared defaults where necessary.
 *
 * Do NOT add structural (flex/size) rules here — those live in ScatterStudio.uss.
 */

/* ── Root light background ─────────────────────────────────────────────────── */
.light.scatter-studio-root,
.light .scatter-studio-root {
    background-color: rgb(196, 196, 196);
}

/* ── Header ─────────────────────────────────────────────────────────────────── */
.light .header {
    background-color: rgb(204, 204, 204);
    border-bottom-color: rgb(170, 170, 170);
}

/* ── Layer rail ─────────────────────────────────────────────────────────────── */
.light .layer-rail {
    background-color: rgb(200, 200, 200);
    border-right-color: rgb(170, 170, 170);
}

.light .layer-rail-footer {
    background-color: rgb(200, 200, 200);
    border-top-color: rgb(170, 170, 170);
}

/* ── Layer row states ────────────────────────────────────────────────────────── */
.light .layer-row:hover {
    background-color: rgba(0, 0, 0, 0.07);
}

.light .layer-row--selected {
    background-color: rgba(63, 127, 210, 0.28);
}

.light .layer-row--selected:hover {
    background-color: rgba(63, 127, 210, 0.38);
}

/* ── Color chip border ──────────────────────────────────────────────────────── */
.light .layer-color-chip {
    border-color: rgba(0, 0, 0, 0.25);
}

/* ── Layer name label ───────────────────────────────────────────────────────── */
.light .layer-name-label {
    color: rgb(30, 30, 30);
}

/* ── Remove button ──────────────────────────────────────────────────────────── */
.light .layer-remove-button {
    color: rgb(80, 80, 80);
    background-color: transparent;
    border-color: transparent;
}

.light .layer-remove-button:hover {
    background-color: rgba(200, 60, 60, 0.18);
    color: rgb(180, 40, 40);
    border-color: rgba(200, 60, 60, 0.35);
}

/* ── Add layer buttons ──────────────────────────────────────────────────────── */
.light .add-layer-button {
    background-color: rgb(210, 210, 210);
    color: rgb(40, 40, 40);
    border-color: rgb(170, 170, 170);
}

.light .add-layer-button:hover {
    background-color: rgb(222, 222, 222);
}

/* ── Rebuild button ─────────────────────────────────────────────────────────── */
.light .rebuild-button {
    background-color: rgb(210, 210, 210);
    color: rgb(40, 40, 40);
    border-color: rgb(170, 170, 170);
}

.light .rebuild-button:hover {
    background-color: rgb(222, 222, 222);
}

/* ── Content area ───────────────────────────────────────────────────────────── */
.light .content-area {
    background-color: rgb(196, 196, 196);
}

/* ── Layer panel title ──────────────────────────────────────────────────────── */
.light .layer-panel-title {
    color: rgb(25, 25, 25);
}

/* ── Foldout cards ──────────────────────────────────────────────────────────── */
.light .layer-panel-card {
    background-color: rgb(210, 210, 210);
    border-color: rgb(175, 175, 175);
}

.light .layer-panel-card:hover {
    border-color: rgb(145, 145, 145);
}
