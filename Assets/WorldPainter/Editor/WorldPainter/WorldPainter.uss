/*
 * WorldPainter.uss — Pro (dark) skin.
 * Exact Scatter Studio token mirror (design §4.6).
 *
 * Load order: this sheet is loaded first by WorldPainterInspector.
 * WorldPainterLight.uss is loaded second (light skin only) and overrides .light-scoped rules.
 *
 * Skin class is added to the root VisualElement:
 *   .pro   — EditorGUIUtility.isProSkin == true
 *   .light — EditorGUIUtility.isProSkin == false
 */

/* ── Root ──────────────────────────────────────────────────────────────────── */
.world-painter-root {
    flex-direction: column;
    flex-grow: 1;
    font-size: 12px;
}

/* Pro root background */
.pro.world-painter-root,
.pro .world-painter-root {
    background-color: rgb(45, 45, 45);
}

/* ── Filter chip bar ─────────────────────────────────────────────────────── */
.wp-filter-bar {
    flex-direction: row;
    flex-shrink: 0;
    padding: 4px 4px 2px 4px;
    flex-wrap: wrap;
}

.wp-chip {
    border-radius: 8px;
    font-size: 12px;
    padding: 2px 8px;
    margin: 2px;
    border-width: 1px;
    height: 22px;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.pro .wp-chip {
    background-color: rgb(62, 62, 62);
    color: rgb(180, 180, 180);
    border-color: rgb(40, 40, 40);
}

.pro .wp-chip:hover {
    background-color: rgb(75, 75, 75);
    color: rgb(210, 210, 210);
}

.pro .wp-chip--active {
    background-color: rgba(77, 153, 255, 0.25);
    color: rgb(77, 153, 255);
    border-color: rgb(77, 153, 255);
}

/* ── Stack root ──────────────────────────────────────────────────────────── */
.wp-stack-root {
    flex-direction: column;
    flex-shrink: 0;
}

/* Stack header */
.wp-stack-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-bottom-width: 1px;
}

.pro .wp-stack-header {
    border-bottom-color: rgb(30, 30, 30);
}

.wp-stack-title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
}

.pro .wp-stack-title {
    color: rgb(210, 210, 210);
}

.wp-add-btn {
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 12px;
}

/* Brush tool / shape mode buttons (BrushDock contextual palette + Circle/Square toggle).
   Default is a flat button; --active gets a thicker accent border so the user can SEE
   which tool/shape is selected. */
.wp-mode-btn {
    border-radius: 3px;
    padding: 2px 6px;
    margin-right: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 11px;
}

.wp-mode-btn--active {
    border-width: 2px;
    border-color: rgb(77, 155, 255);
    background-color: rgba(77, 155, 255, 0.12);
}

.pro .wp-mode-btn--active {
    border-color: rgb(102, 178, 255);
    background-color: rgba(102, 178, 255, 0.18);
    color: rgb(230, 230, 230);
}

.pro .wp-add-btn {
    background-color: rgb(62, 62, 62);
    color: rgb(200, 200, 200);
    border-color: rgb(40, 40, 40);
}

.pro .wp-add-btn:hover {
    background-color: rgb(75, 75, 75);
}

/* Stack list */
.wp-stack-list {
    flex-direction: column;
}

/* ── Layer row ───────────────────────────────────────────────────────────── */
.wp-layer-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 3px 4px;
    border-radius: 4px;
    margin: 1px 3px;
    cursor: link;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.pro .wp-layer-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.pro .wp-layer-row--selected {
    background-color: rgba(63, 127, 210, 0.35);
    transition-duration: 0.08s;
}

.pro .wp-layer-row--selected:hover {
    background-color: rgba(63, 127, 210, 0.45);
}

/* Eye/lock toggles */
.wp-eye-toggle,
.wp-lock-toggle {
    flex-shrink: 0;
    width: 16px;
    margin-right: 3px;
}

/* Type icon chip */
.wp-type-chip {
    flex-shrink: 0;
    font-size: 12px;
    margin-right: 4px;
    width: 18px;
}

/* Layer name */
.wp-layer-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

.pro .wp-layer-name {
    color: rgb(210, 210, 210);
}

/* ── Brush dock ──────────────────────────────────────────────────────────── */
.wp-brush-dock {
    flex-direction: column;
    flex-shrink: 0;
    padding: 4px 6px 6px 6px;
    border-top-width: 1px;
    margin-top: 4px;
}

.pro .wp-brush-dock {
    background-color: rgb(50, 50, 50);
    border-top-color: rgb(30, 30, 30);
}

.wp-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.pro .wp-section-title {
    color: rgb(210, 210, 210);
}

/* Brush field rows */
.wp-field-row {
    flex-direction: column;
    margin-top: 2px;
    margin-bottom: 2px;
}

.wp-brush-slider {
    flex-grow: 1;
}

/* ── Splat swatch chip (albedo thumbnail in layer row) ───────────────────── */
.wp-splat-swatch {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 4px;
    border-radius: 2px;
    border-width: 1px;
    background-size: cover;
}

.pro .wp-splat-swatch {
    border-color: rgb(40, 40, 40);
    background-color: rgb(70, 70, 70);
}

/* ── Splat layer card (selected-layer detail panel) ───────────────────────── */
.wp-splat-card {
    flex-direction: column;
    margin: 3px 4px;
    padding: 6px;
    border-radius: 4px;
    border-width: 1px;
}

.pro .wp-splat-card {
    background-color: rgb(50, 50, 50);
    border-color: rgb(36, 36, 36);
}

.wp-splat-card-thumb {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 3px;
    border-width: 1px;
    background-size: cover;
    margin-bottom: 4px;
    align-self: center;
}

.pro .wp-splat-card-thumb {
    border-color: rgb(40, 40, 40);
    background-color: rgb(60, 60, 60);
}

/* ── Remove button ──────────────────────────────────────────────────────── */
.wp-remove-btn {
    border-radius: 2px;
    width: 18px;
    height: 18px;
    font-size: 10px;
    padding: 0;
    flex-shrink: 0;
    margin-left: 3px;
}

.pro .wp-remove-btn {
    background-color: rgb(62, 62, 62);
    color: rgb(160, 160, 160);
    border-color: rgb(40, 40, 40);
}

.pro .wp-remove-btn:hover {
    background-color: rgb(90, 40, 40);
    color: rgb(220, 100, 100);
}

/* Foldout card (shared with Scatter Studio) */
.wp-card {
    border-radius: 5px;
    border-width: 1px;
    margin-bottom: 5px;
    padding: 4px 6px 6px 6px;
    transition-property: border-color;
    transition-duration: 0.12s;
}

.pro .wp-card {
    background-color: rgb(55, 55, 55);
    border-color: rgb(36, 36, 36);
}

.pro .wp-card:hover {
    border-color: rgb(80, 80, 80);
}

/* ── P6 Animations ──────────────────────────────────────────────────────── */

/* Expand / collapse 120ms ease */
.wp-expand-collapse {
    transition-property: height, opacity, max-height;
    transition-duration: 0.12s;
    transition-timing-function: ease;
    overflow: hidden;
}

.wp-expand-collapse--collapsed {
    max-height: 0;
    opacity: 0;
}

.wp-expand-collapse--expanded {
    max-height: 400px;
    opacity: 1;
}

/* Tab underline slide */
.wp-tab-bar {
    flex-direction: row;
    padding: 0 4px;
    border-bottom-width: 2px;
}

.pro .wp-tab-bar {
    border-bottom-color: rgb(30, 30, 30);
}

.wp-tab {
    padding: 4px 10px;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    transition-property: border-bottom-color, color;
    transition-duration: 0.12s;
    cursor: link;
}

.wp-tab--active {
    border-bottom-color: rgb(77, 153, 255);
}

.pro .wp-tab {
    color: rgb(160, 160, 160);
}

.pro .wp-tab--active {
    color: rgb(77, 153, 255);
}

/* Hover card elevation */
.pro .wp-card:hover {
    border-color: rgb(80, 80, 80);
    translate: 0 -1px;
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

/* ── Live readout strip ──────────────────────────────────────────────────── */

.wp-readout-strip {
    flex-direction: row;
    padding: 3px 6px;
    border-top-width: 1px;
    flex-shrink: 0;
    flex-wrap: wrap;
}

.pro .wp-readout-strip {
    background-color: rgb(42, 42, 42);
    border-top-color: rgb(30, 30, 30);
}

.wp-readout-cell {
    flex-direction: column;
    padding: 2px 8px 2px 0;
    min-width: 80px;
}

.wp-readout-label {
    font-size: 10px;
    -unity-font-style: normal;
}

.wp-readout-value {
    font-size: 11px;
    -unity-font-style: bold;
}

.pro .wp-readout-label {
    color: rgb(120, 120, 120);
}

.pro .wp-readout-value {
    color: rgb(200, 200, 200);
}

/* ── Mini-map ─────────────────────────────────────────────────────────────── */

.wp-mini-map {
    width: 120px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 3px;
    border-width: 1px;
    margin: 4px;
    overflow: hidden;
}

.pro .wp-mini-map {
    background-color: rgb(30, 30, 30);
    border-color: rgb(50, 50, 50);
}

/* ── Perf badge ───────────────────────────────────────────────────────────── */

.wp-perf-badge {
    flex-direction: row;
    padding: 2px 6px;
    border-radius: 3px;
    border-width: 1px;
    margin: 2px;
    flex-wrap: wrap;
}

.pro .wp-perf-badge {
    background-color: rgb(38, 38, 38);
    border-color: rgb(50, 50, 50);
}

.wp-perf-item {
    flex-direction: row;
    margin-right: 8px;
    align-items: center;
}

.wp-perf-key {
    font-size: 10px;
    margin-right: 3px;
}

.wp-perf-val {
    font-size: 10px;
    -unity-font-style: bold;
}

.pro .wp-perf-key {
    color: rgb(110, 110, 110);
}

.pro .wp-perf-val {
    color: rgb(180, 200, 180);
}

/* ── Coach marks ─────────────────────────────────────────────────────────── */

.wp-coach-mark {
    flex-direction: row;
    align-items: flex-start;
    border-radius: 4px;
    border-width: 1px;
    padding: 6px 8px;
    margin: 4px;
}

.pro .wp-coach-mark {
    background-color: rgba(77, 153, 255, 0.08);
    border-color: rgba(77, 153, 255, 0.35);
}

.wp-coach-mark-icon {
    font-size: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.wp-coach-mark-text {
    font-size: 11px;
    white-space: normal;
}

.pro .wp-coach-mark-text {
    color: rgb(180, 180, 180);
}

/* ── Brush stamp grid ────────────────────────────────────────────────────── */

.wp-stamp-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.wp-stamp-cell {
    width: 72px;
    height: 92px;
    border-radius: 3px;
    border-width: 1px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    cursor: link;
    transition-property: border-color, background-color;
    transition-duration: 0.1s;
    overflow: hidden;
}

.pro .wp-stamp-cell {
    background-color: rgb(55, 55, 55);
    border-color: rgb(40, 40, 40);
}

.pro .wp-stamp-cell:hover {
    background-color: rgb(65, 65, 65);
    border-color: rgb(70, 70, 70);
}

.wp-stamp-cell--selected {
    border-width: 2px;
    border-color: rgb(50, 120, 230);
}

.pro .wp-stamp-cell--selected {
    background-color: rgba(50, 120, 230, 0.15);
}

/* Preset slot bar */
.wp-preset-bar {
    flex-direction: row;
    padding: 2px 4px;
    border-top-width: 1px;
}

.pro .wp-preset-bar {
    border-top-color: rgb(35, 35, 35);
}

.wp-preset-slot {
    flex: 1;
    height: 22px;
    border-radius: 2px;
    border-width: 1px;
    margin: 1px 2px;
    font-size: 10px;
    align-items: center;
    justify-content: center;
    cursor: link;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.pro .wp-preset-slot {
    background-color: rgb(55, 55, 55);
    border-color: rgb(40, 40, 40);
    color: rgb(160, 160, 160);
}

.pro .wp-preset-slot:hover {
    background-color: rgb(68, 68, 68);
}

.wp-preset-slot--occupied {
    border-color: rgb(77, 153, 255);
}

.pro .wp-preset-slot--occupied {
    color: rgb(140, 180, 255);
}
