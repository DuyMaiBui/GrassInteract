// GrassCull.compute
// Phase 3: Compute A — chunk culling kernel.
// Phase 4: Compute B — per-blade cull + LOD bucketing kernel.
// Mobile optimization #5+#6: Compute B split into a count pass + a scatter pass so every LOD's visible
//   blade indices land in ONE shared packed buffer (2-bit LOD tag in the high bits of each uint) instead of
//   three separate bladeCap-sized append buffers. Cuts scratch 12 B/blade -> 4 B/blade and drops the
//   per-kernel SSBO binding count. See docs/GPUGrass.md §8.2 #5, #6.
//
// Kernel index 0: ChunkCull        — culls N chunks against frustum + distance (+Hi-Z); appends visible IDs.
// Kernel index 1: WriteArgsB       — reads the CopyCount result, writes DispatchIndirect args for B, and
//                                    zeroes the per-LOD count buffer for the upcoming count pass.
// Kernel index 2: BladeCullCount   — dispatched indirectly (one group per visible chunk); classifies every
//                                    surviving blade into LOD 0/1/2 and atomically COUNTS per-LOD totals
//                                    (no data written yet — this pass only determines partition sizes).
// Kernel index 3: WriteLodOffsets  — single-thread; turns the 3 per-LOD counts into a prefix-sum base offset
//                                    per LOD (written to lodOffsets, read by the shader's vertex stage),
//                                    seeds lodCursor with the same offsets for the scatter pass, and writes
//                                    each LOD's count into its own indirect draw-args instanceCount field.
// Kernel index 4: BladeCullScatter — SAME indirect dispatch as BladeCullCount (identical chunk assignment,
//                                    so counts and writes always agree); re-classifies each blade (pure,
//                                    deterministic — same result as the count pass) and scatter-writes its
//                                    packed (lod<<30 | index) into its LOD's contiguous partition of the
//                                    single shared visibleBlades buffer.

#pragma kernel ChunkCull
#pragma kernel WriteArgsB
#pragma kernel BladeCullCount
#pragma kernel WriteLodOffsets
#pragma kernel BladeCullScatter

// ─── Structs ────────────────────────────────────────────────────────────────
// ChunkAabb layout must match the C# blittable struct EXACTLY:
//   float3 min  (12 B) then float3 max (12 B) = 24 B total.
struct ChunkAabb
{
    float3 mn;  // min
    float3 mx;  // max
};

// BladeInstance layout must match the C# blittable struct EXACTLY:
//   float3 posWS (12 B) + uint packedYawScale (4 B) + uint hash (4 B) = 20 B total.
struct BladeInstance
{
    float3 posWS;
    uint   packedYawScale;
    uint   hash;
};

// ChunkRange layout must match the C# blittable struct EXACTLY:
//   uint start (4 B) + uint count (4 B) = 8 B total.
struct ChunkRange
{
    uint start;
    uint count;
};

// ─── ChunkCull bindings ──────────────────────────────────────────────────────
StructuredBuffer<ChunkAabb>     chunkAabbs;         // one AABB per chunk
uint                            chunkCount;         // total number of chunks
float4                          frustumPlanes[6];   // xyz=inward normal, w=distance (GeometryUtility convention)
float3                          camPosWS;           // world-space camera position
float                           maxCullSqrDistance; // beyond this squared distance → reject

AppendStructuredBuffer<uint>    visibleChunks;      // output: surviving chunk IDs

// ── [PHASE P3 — Hi-Z occlusion] ──────────────────────────────────────────────
// occlusionEnabled: 0 = skip test (fail-open), 1 = apply Hi-Z occlusion cull.
// When 0, the ChunkCull kernel behaves EXACTLY as Phase 2 (frustum+distance only).
//
// prevViewProj: previous-frame view-projection matrix for reprojecting chunk AABBs.
//   Using prev-frame avoids a chicken-and-egg with the current-frame depth buffer.
//
// hiZ / sampler_hiZ: the Hi-Z pyramid texture (R32F, linear depth metres, mip chain).
//   sampler is Point/Clamp — no filtering; each mip access uses SampleLevel.
//
// hiZSize: (width, height) of mip 0 of the Hi-Z pyramid (half-screen resolution).
//
// hiZMipCount: number of mip levels in the pyramid.
//
// Depth convention: ALL depths stored in the Hi-Z pyramid are LINEAR eye-space distances
//   (metres, positive, increasing away from camera). This sidesteps reversed-Z platform
//   differences entirely. The cull compares LINEAR depths on both sides.
//
// Conservative cull: a chunk is occluded ONLY when its nearest linear depth (the closest
//   corner projected by prevViewProj) is strictly GREATER than the Hi-Z far sample
//   (the FAR depth at that mip texel). A small epsilon guards float round-trip.
//   Over-keep is safe (grass still renders); false-cull is not (grass blinks out).
int                             occlusionEnabled;   // 0 = off (fail-open), 1 = Hi-Z test active
float4x4                        prevViewProj;        // previous-frame view-proj matrix
Texture2D<float>                hiZ;                // Hi-Z pyramid (R32F, linear depth)
SamplerState                    sampler_hiZ;         // Point, Clamp
float2                          hiZSize;            // mip-0 dimensions (baseW, baseH)
int                             hiZMipCount;        // number of mip levels
// ── [END PHASE P3 Hi-Z bindings] ──────────────────────────────────────────────

// ─── WriteArgsB bindings ─────────────────────────────────────────────────────
// visibleCount is a Raw buffer (ByteAddressBuffer) — CopyCount destination must be Raw or IndirectArguments.
// ByteAddressBuffer reads 32-bit words at byte offset. Load(0) reads word at byte offset 0.
ByteAddressBuffer               visibleCount;       // [0] = count written by CopyCount
RWStructuredBuffer<uint>        dispatchArgsB;      // [0]=groupsX [1]=1 [2]=1 for DispatchIndirect

// ─── Per-LOD partition bindings (mobile #5+#6 — shared by the count/offset/scatter kernels) ────────────
// lodCounts: [0]=LOD0 count [1]=LOD1 count [2]=LOD2 count. Zeroed by WriteArgsB, accumulated by
//   BladeCullCount (InterlockedAdd), consumed by WriteLodOffsets.
// lodOffsets: prefix-sum BASE offset per LOD into visibleBlades. Written ONCE by WriteLodOffsets; read by
//   the shader's vertex stage (bound there as _LodOffsets) — never mutated after this frame's dispatch.
// lodCursor: working copy seeded from lodOffsets by WriteLodOffsets; BladeCullScatter atomically advances
//   it per LOD to claim a write slot. Ends the frame equal to the END of each partition (never read by the
//   shader — the shader always reads lodOffsets, the immutable START offsets).
RWStructuredBuffer<uint>        lodCounts;
RWStructuredBuffer<uint>        lodOffsets;
RWStructuredBuffer<uint>        lodCursor;

// The single packed visible-blade buffer (mobile #5): each element is (lod << LOD_SHIFT) | blade index.
// Sized to bladeCap — the sum of all three LOD partitions can never exceed TotalBlades, so one bladeCap-
// sized buffer covers every distribution (unlike three separately-capped buffers, which risk overflow).
RWStructuredBuffer<uint>        visibleBlades;

// Per-LOD indirect draw-args buffers — instanceCount (element index 1) is written by WriteLodOffsets,
// replacing the old per-buffer CopyCounterValue (there is no per-LOD hidden Append counter anymore).
RWStructuredBuffer<uint>        argsLod0;
RWStructuredBuffer<uint>        argsLod1;
RWStructuredBuffer<uint>        argsLod2;

// Packing layout — MUST mirror GpuGrassLodTag.cs (C# test mirror) and the shader's unpack exactly.
#define LOD_SHIFT  30
#define INDEX_MASK 0x3FFFFFFFu
// ── [END per-LOD partition bindings] ──────────────────────────────────────────

// ─── BladeCullCount / BladeCullScatter shared bindings ───────────────────────
// visibleChunkCount is read from the same count buffer WriteArgsB used (no CPU readback needed).
// Both kernels read visibleCount[0] as an upper-bound guard so out-of-range groups exit early.
StructuredBuffer<BladeInstance> blades;             // all blade instances (sorted by chunk)
StructuredBuffer<ChunkRange>    chunkRanges;        // one ChunkRange per chunk
// visibleChunks is declared above as AppendStructuredBuffer for ChunkCull.
// The count/scatter kernels read visibleChunks as a plain StructuredBuffer — HLSL allows re-binding under a
// different register name. However since HLSL forbids two names for the same slot in one kernel, we declare
// a separate read view named visibleChunksRead.
StructuredBuffer<uint>          visibleChunksRead;  // read-only view of the visibleChunks buffer

// LOD bucketing thresholds (squared distances, passed from CPU — sourced from ScatterLayer.LodMaxDistances).
float                           lod0MaxSqrDist;     // <= this → LOD 0
float                           lod1MaxSqrDist;     // <= this → LOD 1; else → LOD 2

// ── [PHASE 3 — Adaptive density] ─────────────────────────────────────────────
// densityThreshold: 0..256 range. A blade is KEPT when (b.hash % 256) < densityThreshold.
//   256 = full density (all blades pass).
//   160 = ~62 % density (floor — field never goes bald; enforced on CPU side, see GrassDensityController).
//   0   = theoretical zero density (never set in practice due to the CPU floor).
// The skip uses the blade's stable per-blade hash so the SAME blades are dropped every frame
// → no shimmer, deterministic thinning.
uint                            densityThreshold;   // 0..256; 256 = full density
// ── [END PHASE 3 bindings] ────────────────────────────────────────────────────

// ── [PHASE 5a — LOD2 far-field density falloff] ──────────────────────────────
// Thins out far-field (LOD2) blades by a distance-ramped keep-fraction that is
// COMPOSED ON TOP of the Phase 3 flat density skip.  The effective keep fraction
// for LOD2 blades is:
//
//   keepFraction = lerp(1.0, LOD2_DENSITY_FAR_FRACTION, normalizedDist)
//
// where normalizedDist = saturate((sqrDist - lod1MaxSqrDist) /
//                                 (maxCullSqrDistance - lod1MaxSqrDist))
// so the ramp is 0 at the LOD1→LOD2 boundary and 1 at the overall cull radius.
//
// The check reuses the blade's existing `b.hash` (same per-blade stable value used by
// Phase 3) — just with a smaller modulus (1024) for a finer step.  DRY: no new hash.
// LOD2_DENSITY_FAR_FRACTION = 0.4 ≈ keep 40% at maximum cull distance.
//
// LOD0 and LOD1 blades are UNAFFECTED — only blades that actually classify as LOD2
// pass through the LOD2 branch and may be skipped here.
#define LOD2_DENSITY_FAR_FRACTION 0.4
// ── [END PHASE 5a bindings] ──────────────────────────────────────────────────

// Per-blade frustum-cull margin (metres). The per-blade test below uses only the blade ROOT point,
// which has zero vertical extent — so a blade whose root is just outside a plane but whose HEAD/tip is
// still visible would be wrongly culled. Treat each blade as a sphere of radius bladeCullMargin at its
// root and pad every plane by it. SSOT: CPU sets this = MaxBladeHeight*scaleMax + BendHeadroom (+ extra),
// the SAME expression the chunk-AABB baker uses for bladeReachY (its Y inflation) — so per-blade and
// per-chunk inflation stay in lockstep on the near/far axis. 0 = original point-test behaviour.
//
// Isotropic sphere — intentional conservatism (both safe, never produces holes):
//  • Lateral planes are padded by this Y-reach, which is larger than the baker's smaller lateralPad
//    (= maxScale + BendHeadroom). Over-keeps a thin ring of blades at lateral frustum edges; the
//    rasterizer clips the truly off-screen ones. Cheaper than a second lateral uniform.
//  • Near plane: blades whose root is up to bladeCullMargin BEHIND the near plane pass this test
//    (a real grass blade there has no visible head); they are left to clip-space culling / the
//    distance reject below. Acceptable for a single-scalar sphere model.
float                           bladeCullMargin;

// ─── ChunkCull kernel ────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void ChunkCull(uint3 id : SV_DispatchThreadID)
{
    uint chunkId = id.x;
    if (chunkId >= chunkCount)
        return;

    ChunkAabb aabb = chunkAabbs[chunkId];

    // 1. Empty-sentinel test: baked empty cells have min > max.
    if (aabb.mn.x > aabb.mx.x)
        return;

    // 2. Distance reject — nearest point of AABB to camPos, squared distance.
    //    Clamp camPos into [mn, mx] per axis → nearest point on or in the box.
    float3 nearest;
    nearest.x = clamp(camPosWS.x, aabb.mn.x, aabb.mx.x);
    nearest.y = clamp(camPosWS.y, aabb.mn.y, aabb.mx.y);
    nearest.z = clamp(camPosWS.z, aabb.mn.z, aabb.mx.z);

    float3 delta = camPosWS - nearest;
    float sqrDist = dot(delta, delta);
    // maxCullSqrDistance <= 0 means "no cull" (matches GrassRenderer CPU contract: cull==0 → render all).
    if (maxCullSqrDistance > 0.0 && sqrDist > maxCullSqrDistance)
        return;

    // 3. Frustum reject — positive-vertex (n-vertex) test against each of 6 planes.
    //    Convention (GeometryUtility): dot(plane.xyz, p) + plane.w >= 0 means INSIDE.
    //    For AABB vs plane: use the positive vertex (the corner that is most in the
    //    direction of the plane normal). If the positive vertex is outside (< 0), the
    //    entire box is outside that plane → cull.
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 plane = frustumPlanes[i];
        // Positive vertex: for each axis, choose the component that maximises dot with normal.
        float3 pVertex;
        pVertex.x = (plane.x >= 0.0f) ? aabb.mx.x : aabb.mn.x;
        pVertex.y = (plane.y >= 0.0f) ? aabb.mx.y : aabb.mn.y;
        pVertex.z = (plane.z >= 0.0f) ? aabb.mx.z : aabb.mn.z;

        // If the most-inward corner is outside this plane, the whole box is outside → cull.
        if (dot(plane.xyz, pVertex) + plane.w < 0.0f)
            return;
    }

    // 4. Hi-Z occlusion test (Phase P3 — behind flag occlusionEnabled).
    //    Skip entirely when occlusionEnabled == 0 → exact Phase-2 behaviour.
    if (occlusionEnabled != 0)
    {
        // Project all 8 AABB corners through prevViewProj to find:
        //   • screen UV rect covering the chunk (clamped to [0,1])
        //   • nearest linear eye-depth (smallest w among forward-facing corners)
        //
        // Depth convention: prevViewProj is a Unity column-major view-projection.
        // clip.w = -z_eye (GL convention) or z_eye (DX/Metal). In BOTH cases clip.w
        // is the homogeneous w that, after perspective divide (x/w, y/w), gives NDC.
        // We use clip.w as the proxy for linear eye-depth because it is MONOTONE with
        // distance along the view axis for a standard perspective projection, and we
        // never compare it to absolute Hi-Z metres — we only compare it to the value
        // stored in the pyramid, which was linearised by LinearEyeDepthFromRaw in the
        // CopyDepth kernel using the SAME camera's _ZBufferParams.
        //
        // Fail-open: if ALL 8 corners have w <= 0 (behind camera) OR the rect is
        // degenerate → keep the chunk, do NOT cull.

        float3 corners[8];
        corners[0] = float3(aabb.mn.x, aabb.mn.y, aabb.mn.z);
        corners[1] = float3(aabb.mx.x, aabb.mn.y, aabb.mn.z);
        corners[2] = float3(aabb.mn.x, aabb.mx.y, aabb.mn.z);
        corners[3] = float3(aabb.mx.x, aabb.mx.y, aabb.mn.z);
        corners[4] = float3(aabb.mn.x, aabb.mn.y, aabb.mx.z);
        corners[5] = float3(aabb.mx.x, aabb.mn.y, aabb.mx.z);
        corners[6] = float3(aabb.mn.x, aabb.mx.y, aabb.mx.z);
        corners[7] = float3(aabb.mx.x, aabb.mx.y, aabb.mx.z);

        float rectMinX =  1e30f;
        float rectMinY =  1e30f;
        float rectMaxX = -1e30f;
        float rectMaxY = -1e30f;
        float nearDepth =  1e30f; // smallest w (nearest corner)
        int   behindCount = 0;

        [unroll]
        for (int ci = 0; ci < 8; ci++)
        {
            float4 c = float4(corners[ci], 1.0f);
            float4 clip = mul(prevViewProj, c);

            if (clip.w <= 1e-6f)
            {
                behindCount++;
                continue;
            }

            float invW = 1.0f / clip.w;
            float uvX = clip.x * invW * 0.5f + 0.5f;
            float uvY = clip.y * invW * 0.5f + 0.5f;
            float eyeD = clip.w; // monotone proxy for linear depth

            rectMinX = min(rectMinX, uvX);
            rectMinY = min(rectMinY, uvY);
            rectMaxX = max(rectMaxX, uvX);
            rectMaxY = max(rectMaxY, uvY);
            nearDepth = min(nearDepth, eyeD);
        }

        // Fail-open: all corners behind or degenerate rect → keep chunk.
        bool degenerate = (behindCount == 8) || (rectMaxX <= rectMinX) || (rectMaxY <= rectMinY);
        if (!degenerate)
        {
            // Clamp rect to [0,1] (partially off-screen chunks still get a valid sub-rect).
            rectMinX = saturate(rectMinX);
            rectMinY = saturate(rectMinY);
            rectMaxX = saturate(rectMaxX);
            rectMaxY = saturate(rectMaxY);

            bool clampedDegenerate = (rectMaxX <= rectMinX) || (rectMaxY <= rectMinY);
            if (!clampedDegenerate)
            {
                // Rect in pixel space at mip 0.
                float pixW = (rectMaxX - rectMinX) * hiZSize.x;
                float pixH = (rectMaxY - rectMinY) * hiZSize.y;
                float rectMaxDim = max(pixW, pixH);

                // Select coarsest mip whose single texel covers the rect.
                // texelSize at mip m = (1 << m). Find smallest m s.t. (1 << m) >= rectMaxDim.
                int mip = 0;
                while (mip < hiZMipCount - 1 && (1 << mip) < (int)rectMaxDim)
                    mip++;
                mip = clamp(mip, 0, hiZMipCount - 1);

                // Sample the Hi-Z far depth at the centre of the rect.
                float2 sampleUV = float2((rectMinX + rectMaxX) * 0.5f, (rectMinY + rectMaxY) * 0.5f);
                float hiZFar = hiZ.SampleLevel(sampler_hiZ, sampleUV, mip).r;

                // Occlusion: chunk is hidden only when the nearest corner depth is
                // STRICTLY beyond the Hi-Z far depth (a small epsilon for float safety).
                // hiZFar = LINEAR metres (from CopyDepth linearisation).
                // nearDepth = clip.w = eye-space proxy from prevViewProj.
                //
                // IMPORTANT: nearDepth and hiZFar are in DIFFERENT units if the camera
                // changed its near/far since last frame. On a single stable camera this
                // matches perfectly; on camera cuts there may be a one-frame miss-cull,
                // which is fail-open-safe (worst case: one frame of a visible chunk not culled).
                //
                // The epsilon (0.05m in clip-w space, approximately) absorbs blade reach
                // above the terrain surface so grass tips poking above an occluder are kept.
                const float OCCLUSION_EPSILON = 0.05f;
                if (nearDepth > hiZFar + OCCLUSION_EPSILON)
                    return; // chunk is fully occluded — do NOT append
            }
        }
    }
    // ── [END PHASE P3 Hi-Z test] ──────────────────────────────────────────────

    // 5. Survived all tests — append this chunk's ID.
    visibleChunks.Append(chunkId);
}

// ─── WriteArgsB kernel ───────────────────────────────────────────────────────
// Single-thread kernel; dispatch with (1,1,1) groups.
// Reads the count written by CopyCount and fills DispatchIndirect args for Compute B, and zeroes the
// per-LOD count buffer that BladeCullCount is about to accumulate into.
//
// PHASE 4 DESIGN: BladeCullCount/Scatter use one thread GROUP per visible CHUNK (grid-stride within the
// group over that chunk's blades). Therefore groupsX = visibleChunkCount directly — one group
// per slot, not one group per batch-of-64. PHASE4_GROUP is 1u (not 64u) to express this.
// The Phase 3 harness was updated accordingly: dispatchArgsB[0] == M (not ceil(M/64)).
[numthreads(1, 1, 1)]
void WriteArgsB(uint3 id : SV_DispatchThreadID)
{
    // ByteAddressBuffer.Load(byteOffset) — offset 0 = first uint.
    uint count = visibleCount.Load(0);
    // One group per visible chunk → groupsX == count.
    dispatchArgsB[0] = count;
    dispatchArgsB[1] = 1u;
    dispatchArgsB[2] = 1u;

    // Zero the per-LOD counters before BladeCullCount accumulates into them this frame.
    lodCounts[0] = 0u;
    lodCounts[1] = 0u;
    lodCounts[2] = 0u;
}

// ─── Shared per-blade classification (BladeCullCount + BladeCullScatter) ─────
// Both kernels dispatch over the IDENTICAL chunk/thread assignment and call this SAME deterministic
// function, so the count pass and the scatter pass always agree exactly on which blades survive and which
// LOD they land in — no drift, no dropped/duplicated blades (Guard 3).
// Returns false when the blade should be dropped entirely (density skip, frustum, or beyond cull distance).
bool ClassifyBlade(BladeInstance b, out uint lod)
{
    lod = 0;

    // ── [PHASE 3] Adaptive density stable-hash skip ───────────────────
    // Skip when (b.hash % 256) >= densityThreshold. Placed BEFORE the
    // frustum test so culled blades incur zero further work (cheapest early-out).
    if ((b.hash % 256u) >= densityThreshold)
        return false;
    // ── [END PHASE 3 density skip] ────────────────────────────────────

    // ── Per-blade frustum test (point vs 6 planes) ────────────────────
    // GeometryUtility convention: dot(n, p) + w >= 0 → inside.
    float3 posWS = b.posWS;
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 plane = frustumPlanes[i];
        // Pad by bladeCullMargin: treat the blade as a sphere of that radius at its root so a
        // root-outside / head-inside blade survives (mirrors the chunk-AABB Y/lateral inflation).
        if (dot(plane.xyz, posWS) + plane.w < -bladeCullMargin)
            return false;
    }

    // ── Distance + LOD bucket ─────────────────────────────────────────
    float3 d = posWS - camPosWS;
    float sqrDist = dot(d, d);

    // Beyond the overall max cull distance → skip entirely.
    // maxCullSqrDistance <= 0 means "no cull" (matches GrassRenderer CPU contract: cull==0 → render all).
    if (maxCullSqrDistance > 0.0 && sqrDist > maxCullSqrDistance)
        return false;

    if (sqrDist <= lod0MaxSqrDist)
    {
        lod = 0;
        return true;
    }
    if (sqrDist <= lod1MaxSqrDist)
    {
        lod = 1;
        return true;
    }

    // ── [PHASE 5a] LOD2 distance-ramped density falloff ───────────────
    // Only blades that land in LOD2 (far field) are subject to the additional distance-ramped
    // thinning. LOD0/LOD1 blades ALWAYS survive to their return above (unchanged from Phase 3 baseline).
    lod = 2;
    float lod2RangeInvSqr = (maxCullSqrDistance > lod1MaxSqrDist + 1e-3)
        ? 1.0 / (maxCullSqrDistance - lod1MaxSqrDist) : 0.0;
    float normalizedDist = saturate((sqrDist - lod1MaxSqrDist) * lod2RangeInvSqr);

    // Distance-ramped keep-fraction: lerp(1.0, LOD2_DENSITY_FAR_FRACTION, t).
    float keepFraction = lerp(1.0, LOD2_DENSITY_FAR_FRACTION, normalizedDist);

    // Reuse the blade's stable hash (same field as Phase 3) with a 1024-step modulus for a finer-grained
    // stochastic skip. Same-blades-every-frame → no shimmer.
    uint lod2Hash = b.hash % 1024u;
    if (lod2Hash >= (uint)(keepFraction * 1024.0))
        return false; // skip this far-field blade

    return true;
}

// ─── BladeCullCount kernel ────────────────────────────────────────────────────
// Dispatched INDIRECTLY via DispatchComputeIndirect(dispatchArgsB) = [visibleChunkCount, 1, 1].
// One thread GROUP per visible chunk; 64 threads per group. Classifies every blade and atomically
// increments its LOD's counter — no data write yet (that happens in BladeCullScatter once the
// per-LOD base offsets are known).
[numthreads(64, 1, 1)]
void BladeCullCount(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint slot = groupId.x;

    uint visChunkCount = visibleCount.Load(0);
    if (slot >= visChunkCount)
        return;

    uint chunkId = visibleChunksRead[slot];
    ChunkRange r = chunkRanges[chunkId];
    uint tid = threadId.x;

    // Grid-stride loop: each thread processes blades at indices tid, tid+64, tid+128, ...
    for (uint k = tid; k < r.count; k += 64u)
    {
        uint globalIdx = r.start + k;
        BladeInstance b = blades[globalIdx];

        uint lod;
        if (!ClassifyBlade(b, lod))
            continue;

        InterlockedAdd(lodCounts[lod], 1u);
    }
}

// ─── WriteLodOffsets kernel ──────────────────────────────────────────────────
// Single-thread kernel; dispatch with (1,1,1) groups. Turns the 3 per-LOD counts (exact, from
// BladeCullCount) into prefix-sum base offsets, seeds the scatter cursor, and writes each LOD's
// instanceCount directly into its indirect draw-args buffer (replacing the old per-LOD CopyCounterValue —
// there is no longer a per-LOD hidden Append counter to copy from).
[numthreads(1, 1, 1)]
void WriteLodOffsets(uint3 id : SV_DispatchThreadID)
{
    uint c0 = lodCounts[0];
    uint c1 = lodCounts[1];
    uint c2 = lodCounts[2];

    uint o0 = 0u;
    uint o1 = c0;
    uint o2 = c0 + c1;

    lodOffsets[0] = o0; lodOffsets[1] = o1; lodOffsets[2] = o2;
    lodCursor[0]  = o0; lodCursor[1]  = o1; lodCursor[2]  = o2;

    // IndirectDrawIndexedArgs layout: [0]=indexCountPerInstance [1]=instanceCount [2]=startIndex
    // [3]=baseVertexIndex [4]=startInstance. Only instanceCount changes per frame.
    argsLod0[1] = c0;
    argsLod1[1] = c1;
    argsLod2[1] = c2;
}

// ─── BladeCullScatter kernel ─────────────────────────────────────────────────
// SAME indirect dispatch args as BladeCullCount (dispatchArgsB is unchanged between the two — the visible
// chunk set does not change mid-frame), so both passes iterate the IDENTICAL chunk/thread assignment.
// Re-classifies each blade (deterministic — same inputs, same result as BladeCullCount) and scatter-writes
// its packed (lod<<30 | index) into its LOD's contiguous partition of visibleBlades.
[numthreads(64, 1, 1)]
void BladeCullScatter(uint3 groupId   : SV_GroupID,
                       uint3 threadId  : SV_GroupThreadID)
{
    uint slot = groupId.x;

    uint visChunkCount = visibleCount.Load(0);
    if (slot >= visChunkCount)
        return;

    uint chunkId = visibleChunksRead[slot];
    ChunkRange r = chunkRanges[chunkId];
    uint tid = threadId.x;

    for (uint k = tid; k < r.count; k += 64u)
    {
        uint globalIdx = r.start + k;
        BladeInstance b = blades[globalIdx];

        uint lod;
        if (!ClassifyBlade(b, lod))
            continue;

        uint writeSlot;
        InterlockedAdd(lodCursor[lod], 1u, writeSlot);
        visibleBlades[writeSlot] = (lod << LOD_SHIFT) | (globalIdx & INDEX_MASK);
    }
}
